# ---------------------------------------------------------------------------------------------------------------
# The development containers. None of this reaches the application; it configures the images around it, which read
# this file directly (see compose.override.yaml).
# ---------------------------------------------------------------------------------------------------------------

# The MariaDB container is configured separately from the `web` connection above, so its credentials have to be
# changed along with DOCTRINE_WEB_USER, DOCTRINE_WEB_PASSWORD and DOCTRINE_WEB_DATABASE.
MARIADB_ROOT_PASSWORD=gewis
MARIADB_DATABASE=gewis
MARIADB_USER=gewis
MARIADB_PASSWORD=gewis
MARIADB_ALLOW_EMPTY_PASSWORD='yes'

# The PostgreSQL container, and the database Listmonk keeps beside the ledger on it. `POSTGRES_USER` and
# `POSTGRES_PASSWORD` are the image's own names for the superuser it creates, so they follow DOCTRINE_DEFAULT_*.
POSTGRES_USER=gewisdb
POSTGRES_PASSWORD=gewisdb
POSTGRES_LISTMONK_DATABASE=gewisdb_listmonk

# Mailman keeps its database on MariaDB, shared by the core and the web front end.
MAILMAN_DATABASE_DBNAME=mailman
MAILMAN_DATABASE_USERNAME=mailman
MAILMAN_DATABASE_PASSWORD=mailman

PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED=False
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_CONFIG_UPGRADE_CHECK_ENABLED=False
PGADMIN_CONFIG_USER_INACTIVITY_TIMEOUT=0
PGADMIN_DEFAULT_EMAIL=pgadmin4@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=pgadmin
PGADMIN_DISABLE_POSTFIX=true

PMA_HOST=mariadb
PMA_USER=gewis
PMA_PASSWORD=gewis

MATOMO_DATABASE_ADAPTER=mariadb
MATOMO_DATABASE_HOST=mariadb
MATOMO_DATABASE_PORT=3306
MATOMO_DATABASE_USERNAME=matomo
MATOMO_DATABASE_PASSWORD=matomo
MATOMO_DATABASE_DBNAME=matomo
MATOMO_DATABASE_SSL=0

# Prefilled on the sign-in form, so a fresh stack can be signed into without looking anything up. A member number,
# since that is what the sign-in asks for: the register has no accounts of its own any more, and 8000 is seeded
# holding both the website's and the register's administrator roles.
DEMO_CREDENTIALS_USERNAME=8000
DEMO_CREDENTIALS_PASSWORD=gewiswebgewis

# The administrator the development stack creates in Mailman's and Listmonk's own web interfaces. Nothing the
# application signs in with -- it reaches both over their APIs, with the credentials above.
DEV_TOOLS_ADMIN_USERNAME=admin
DEV_TOOLS_ADMIN_PASSWORD=gewisdbgewis

# PHP takes its timezone from the image's ini; these are for the containers around it, Postgres in particular.
TZ=Europe/Amsterdam
PGTZ=Europe/Amsterdam

# Names the IDE's server configuration, which carries the path mapping from /app back to the checkout on the host.
# Without it a breakpoint is hit but the IDE cannot say which file it is in. See https://xdebug.org/docs/all_settings#mode
PHP_IDE_CONFIG=serverName=localhost
XDEBUG_MODE=off
