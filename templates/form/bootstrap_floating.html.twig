{% use 'bootstrap_5_layout.html.twig' %}

{#
    Two rows cannot float, and both stay readable rather than collapsing:

    - A compound row (a fieldset, a repeated password, an embedded type) and an expanded choice are not single
      controls, so `.form-floating` has nothing to float over and would fold the label on top of the first
      option. Those rows keep a label above them.
    - `form_help` is rendered on every branch. Dropping it loses every `help` a form type declares, which is
      the only place some fields explain themselves, the student number for one.
#}
{% block form_row %}
    {% if compound and form.children is not empty and form.children|filter(child => 'hidden' not in child.vars.block_prefixes)|length == 0 %}
        {# A compound of nothing but hidden fields has nothing on the page to label; labelling it anyway puts a
           legend above an empty space. A compound with no children at all is a different thing -- an empty
           collection waiting to be added to -- and keeps its label. #}
        {{ form_widget(form) }}
        {{ form_errors(form) }}
    {% elseif compound or expanded|default(false) %}
        <div class="mb-2">
            {{ form_label(form) }}
            {{ form_widget(form) }}
            {{ form_help(form) }}
            {{ form_errors(form) }}
        </div>
    {% else %}
        <div class="form-floating mb-2">
            {{ form_widget(form) }}
            {{ form_label(form) }}
            {{ form_help(form) }}
            {{ form_errors(form) }}
        </div>
    {% endif %}
{% endblock %}

{#
    A floating label needs the control to have a placeholder, because what it floats on is
    `:placeholder-shown`. The label is the placeholder unless the template set one of its own.
#}
{% block form_widget_simple %}
    {% set placeholder = attr.placeholder|default(label|default('')) %}
    {% if placeholder is not empty %}
        {% set attr = attr|merge({placeholder: placeholder}) %}
    {% endif %}
    {{ parent() }}
{% endblock %}

{# `checkbox_widget` already renders the whole `.form-check`, so wrapping it in `.form-floating` (the
   generic form_row above) breaks its layout. Render it plainly. #}
{% block checkbox_row %}
    <div class="mb-2">
        {{ form_widget(form) }}
        {{ form_help(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{#
    `bootstrap_5_layout` defaults a submit button to `btn-primary`, which is the framework blue rather than
    the theme's. A template that wants something else still passes it; this is only the default.
#}
{% block submit_widget %}
    {% set attr = attr|merge({class: attr.class|default('btn-gewis-primary')|trim}) %}
    {{ parent() }}
{% endblock %}

{#
    An option of an expanded choice inherits the group's `required`, so leaving it set puts the asterisk on
    every radio in the list instead of once on the group.
#}
{% block checkbox_radio_label %}
    {% if parent_label_class is defined %}
        {% set required = false %}
    {% endif %}
    {{ parent() }}
{% endblock %}
