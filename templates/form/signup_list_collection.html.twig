{# The same collapse strategy as the read-only accordion on the activity view page
   (templates/partials/activity/signup-list.html.twig). The prototype already contains the whole panel, so
   adding an entry clones it with its placeholder (`__list__` / `__field__`) replaced by a fresh index,
   keeping the collapse target ids unique. #}

{% macro tier_modifier(field, ranks, label, settings, places = null) %}
    {% set on = field.vars.value is not empty %}
    <div class="mb-3" data-controller="tier-order">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="{{ field.vars.id }}_switch"
                   data-tier-order-target="toggle" data-action="change->tier-order#toggle"
                   {% if on %}checked{% endif %}{% if field.vars.disabled %} disabled{% endif %}>
            <label class="form-check-label" for="{{ field.vars.id }}_switch">{{ label }}</label>
        </div>
        <div class="ms-4 mt-2" data-tier-order-target="panel"{% if not on %} hidden{% endif %}>
            {{ form_widget(field, {'attr': {'data-tier-order-target': 'value'}}) }}
            <ol class="tier-order list-unstyled mb-0" data-tier-order-target="entries"
                data-action="dragover->tier-order#dragOver drop->tier-order#drop">
                {% for rank in ranks %}
                    {% set rankKey = rank|map(tier => tier.value)|join('+') %}
                    {% for tier in rank %}
                        <li class="tier-order-entry d-flex align-items-center gap-2 border rounded px-2 py-1 mb-1{{ not loop.first ? ' tier-order-entry--tied' }}"
                            data-tier-order-target="entry" data-tier-order-value-param="{{ tier.value }}"
                            data-tier-order-tied-param="{{ not loop.first ? '1' : '0' }}"
                            {% if not field.vars.disabled %}draggable="true"
                            data-action="dragstart->tier-order#dragStart dragend->tier-order#dragEnd"{% endif %}>
                            <span class="form-stepper-badge" data-tier-order-target="rank" aria-hidden="true"></span>
                            {% if not field.vars.disabled %}
                                <span class="sortable-handle" role="button" aria-label="{{ 'Reorder tier'|trans }}">
                                    <span class="fas fa-arrows-up-down"></span>
                                </span>
                            {% endif %}
                            <span class="flex-grow-1">{{ tier|trans }}</span>
                            {% if places is not null %}
                                {# The places are held for the rank rather than for one tier, so the number sits on
                                   the row the rank starts on and the tiers tied to it share what it says. #}
                                <span class="flex-shrink-0" style="width: 4.5rem" data-tier-order-target="placesBox"
                                      data-signup-list-target="membershipPlaces">
                                    <input type="number" min="0" class="form-control form-control-sm"
                                           aria-label="{{ 'Places held for this rank'|trans }}"
                                           data-tier-order-target="places"
                                           data-action="input->tier-order#write"
                                           value="{{ loop.first ? places[rankKey]|default('') }}"
                                           {% if field.vars.disabled %}disabled{% endif %}>
                                </span>
                            {% endif %}
                            {% if not field.vars.disabled %}
                                <button type="button" class="btn btn-sm btn-outline-secondary border-0" data-tier-order-target="tie"
                                        data-action="tier-order#tie"
                                        title="{{ 'Admit this tier together with the one above it'|trans }}"
                                        aria-label="{{ 'Admit this tier together with the one above it'|trans }}">
                                    <span class="fas fa-link" aria-hidden="true"></span>
                                </button>
                            {% endif %}
                        </li>
                    {% endfor %}
                {% endfor %}
            </ol>
            <p class="form-text mb-0">{{ 'Tiers on the same number are admitted together.'|trans }}</p>
            {{ settings|default('') }}
        </div>
    </div>
{% endmacro %}

{% macro signup_field_panel(child, collapse_id, remove_label) %}
    <div class="panel mb-3" data-form-collection-target="entry">
        {# The drag handle is a sibling of (never nested in) the collapse button: a nested interactive element would
           fight `data-bs-toggle` and swallow text selection. It is offered only when the fields collection is
           editable, since a frozen list ignores its submissions. #}
        <div class="panel-heading d-flex align-items-center gap-2">
            {% if not child.vars.disabled %}
                <span class="sortable-handle" draggable="true"
                      data-action="dragstart->sortable#dragStart dragend->sortable#dragEnd"
                      role="button" aria-label="{{ 'Reorder question'|trans }}">
                    <span class="fas fa-arrows-up-down"></span>
                </span>
            {% endif %}
            <button type="button"
                    class="panel-collapse-toggle d-flex justify-content-between align-items-center gap-2 w-100 border-0 bg-transparent text-start p-0"
                    data-bs-toggle="collapse" data-bs-target="#{{ collapse_id }}"
                    aria-expanded="true" aria-controls="{{ collapse_id }}">
                <span class="h6 mb-0">{{ 'Question'|trans }} <span class="signup-field-number"></span></span>
                <span class="fas fa-chevron-down panel-collapse-chevron"></span>
            </button>
        </div>
        <div class="collapse show" id="{{ collapse_id }}">
            <div class="panel-body" data-controller="signup-field">
                {{ form_row(child.name) }}
                <div class="row align-items-center mb-2">
                    <div class="col-md-6">{{ form_row(child.type, {'attr': {
                        'data-signup-field-target': 'type',
                        'data-action': 'change->signup-field#typeChanged',
                    }}) }}</div>
                    <div class="col-md-6">{{ form_row(child.isSensitive) }}</div>
                </div>
                {# Both bounds are what the number type exists to ask for, so they carry the asterisk while shown. #}
                <div data-signup-field-target="number">
                    <div class="row">
                        <div class="col-md-6">{{ form_row(child.minimumValue, {'attr': {'data-signup-field-target': 'required'}}) }}</div>
                        <div class="col-md-6">{{ form_row(child.maximumValue, {'attr': {'data-signup-field-target': 'required'}}) }}</div>
                    </div>
                </div>
                <div data-signup-field-target="choice">
                    {{ form_row(child.options, {'add_label': 'Add option'|trans, 'remove_label': 'Remove option'|trans}) }}
                </div>
                {{ form_rest(child) }}
                {# A frozen list's fields collection is disabled and ignores its submissions, so don't offer remove. #}
                {% if not child.vars.disabled %}
                    <button type="button" class="btn btn-sm btn-outline-gewis-primary mt-2"
                            data-action="form-collection#remove">
                        <span class="fas fa-trash"></span> {{ remove_label }}
                    </button>
                {% endif %}
            </div>
        </div>
    </div>
{% endmacro %}

{% macro collection_entry(kind, child, remove_label) %}
    {% import _self as helper %}
    {% if 'field' == kind %}
        {{ helper.signup_field_panel(child, child.vars.id ~ '-collapse', remove_label) }}
    {% elseif 'role' == kind %}
        {{ helper.signup_role_entry(child, remove_label) }}
    {% else %}
        {{ helper.signup_option_entry(child, remove_label) }}
    {% endif %}
{% endmacro %}

{# The scaffold every collection on a list shares: the prototype the add button clones, the entries in a sortable
   wrapper, and the add button itself. A frozen list's collection is disabled and ignores its submissions, so neither
   adding nor reordering is offered on one. #}
{% macro collection(form, kind, add_label, remove_label) %}
    {% import _self as helper %}
    {% set has_prototype = form.vars.allow_add and form.vars.prototype is defined and form.vars.prototype is not null %}
    {% set placeholder = has_prototype ? (form.vars.prototype.vars.name|split('[')|last|trim(']')) : '__' ~ kind ~ '__' %}
    <div id="{{ form.vars.id }}" class="signup-{{ kind }}-collection"
         data-controller="form-collection{% if not form.vars.disabled %} sortable{% endif %}"
         data-form-collection-prototype-name-value="{{ placeholder }}"
         {% if has_prototype %}
             data-form-collection-prototype-value="{{ helper.collection_entry(kind, form.vars.prototype, remove_label)|e('html_attr') }}"
         {% endif %}>
        <div data-form-collection-target="entries" data-sortable-target="entries"
             data-action="dragover->sortable#dragOver drop->sortable#drop">
            {% for child in form %}
                {{ helper.collection_entry(kind, child, remove_label) }}
            {% endfor %}
        </div>
        {% if form.vars.allow_add and not form.vars.disabled %}
            <button type="button" class="btn btn-sm btn-outline-secondary{{ 'field' != kind ? ' mt-2' }}"
                    data-action="form-collection#add">
                <span class="fas fa-plus"></span> {{ add_label }}
            </button>
        {% endif %}
    </div>
{% endmacro %}

{% block signup_field_collection_widget %}
    {% import _self as helper %}
    {{ helper.collection(form, 'field', 'Add a question'|trans, 'Remove question'|trans) }}
{% endblock %}

{% macro signup_option_entry(child, remove_label) %}
    <div class="d-flex align-items-start gap-2 border rounded p-3 mb-2" data-form-collection-target="entry">
        {% if not child.vars.disabled %}
            <span class="sortable-handle mt-2" draggable="true"
                  data-action="dragstart->sortable#dragStart dragend->sortable#dragEnd"
                  role="button" aria-label="{{ 'Reorder option'|trans }}">
                <span class="fas fa-arrows-up-down"></span>
            </span>
        {% endif %}
        <div class="flex-grow-1">
            {{ form_row(child.value) }}
            {{ form_row(child.isDefault) }}
            {{ form_rest(child) }}
            {% if not child.vars.disabled %}
                <button type="button" class="btn btn-sm btn-outline-gewis-primary mt-2"
                        data-action="form-collection#remove">
                    <span class="fas fa-trash"></span> {{ remove_label }}
                </button>
            {% endif %}
        </div>
    </div>
{% endmacro %}

{% macro signup_role_entry(child, remove_label) %}
    <div class="d-flex align-items-start gap-2 border rounded p-3 mb-2" data-form-collection-target="entry">
        {% if not child.vars.disabled %}
            <span class="sortable-handle mt-2" draggable="true"
                  data-action="dragstart->sortable#dragStart dragend->sortable#dragEnd"
                  role="button" aria-label="{{ 'Reorder role'|trans }}">
                <span class="fas fa-arrows-up-down"></span>
            </span>
        {% endif %}
        <div class="flex-grow-1">
            {{ form_row(child.name) }}
            {{ form_row(child.minimum) }}
            {{ form_rest(child) }}
            {% if not child.vars.disabled %}
                <button type="button" class="btn btn-sm btn-outline-gewis-primary mt-2"
                        data-action="form-collection#remove">
                    <span class="fas fa-trash"></span> {{ remove_label }}
                </button>
            {% endif %}
        </div>
    </div>
{% endmacro %}

{% block signup_role_collection_widget %}
    {% import _self as helper %}
    {{ helper.collection(form, 'role', 'Add a role'|trans, 'Remove role'|trans) }}
{% endblock %}

{% block signup_option_collection_widget %}
    {% import _self as helper %}
    {{ helper.collection(form, 'option', add_label|default('Add option'|trans), remove_label|default('Remove option'|trans)) }}
{% endblock %}
