{# A LocalisedTextType (a Dutch and an English value) as two mirrored columns. Each input carries the
   field's own label as its floating label, so the compound renders no separate label of its own. The
   activity "Information" panel renders the valueNL / valueEN children directly and is not affected. #}
{% block localised_text_row %}
    {# Passed through untranslated: each child row's own label block translates it (once, with the form's
       translation domain). #}
    {% set field_label = form.vars.label %}
    <div class="mb-2">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-1"><span class="flag-icon flag-icon-nl"></span> {{ 'Dutch'|trans }}</div>
                {{ form_row(form.valueNL, {
                    'label': field_label,
                    'attr': {'data-localised-fields-target': 'dutch'},
                }) }}
            </div>
            <div class="col-md-6">
                <div class="mb-1"><span class="flag-icon flag-icon-en"></span> {{ 'English'|trans }}</div>
                {{ form_row(form.valueEN, {
                    'label': field_label,
                    'attr': {'data-localised-fields-target': 'english'},
                }) }}
            </div>
        </div>
        {{ form_errors(form) }}
    </div>
{% endblock %}
