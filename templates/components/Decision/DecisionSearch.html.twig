<div {{ attributes }}>
    <div class="panel mb-3">
        <div class="panel-body">
            <label class="form-label" for="decision-search-query">{{ 'Search decisions'|trans }}</label>
            <input type="search" class="form-control" id="decision-search-query"
                   placeholder="{{ 'Keyword or meeting reference, for example “budget” or “GMM 214.12.1”'|trans }}"
                   data-model="debounce(300)|q"
                   value="{{ this.q }}">
            <div class="form-text">
                {{ 'Searches the decision texts and understands meeting references such as “GMM 214” or “BM 1805.3.1”.'|trans }}
                {{ 'Use “quotes” for exact phrases, -word to exclude, type:bm to limit to one meeting type, and meeting:1805 to limit to one meeting.'|trans }}
            </div>
        </div>
    </div>

    {% if this.hasQuery %}
        {% if this.isCapped %}
            <div class="alert alert-warning" role="alert">
                {{ 'Only the first %limit% matches are shown; refine your search to narrow them down.'|trans({'%limit%': constant('App\\Twig\\Components\\Decision\\DecisionSearch::RESULT_CAP')}) }}
            </div>
        {% endif %}

        {% for group in this.resultsByMeeting %}
            <div class="panel">
                <div class="panel-heading d-flex flex-wrap justify-content-between align-items-baseline gap-2">
                    <h3>
                        <a href="{{ path('meetings/view', {'type': group.meeting.type.urlToken, 'number': group.meeting.number}) }}">
                            {{ group.meeting.type.getName|trans }} {{ group.meeting.number }}
                        </a>
                    </h3>
                    <span class="text-muted small">{{ group.meeting.date|format_date('full') }}</span>
                </div>
                <div class="panel-body">
                    {% for decision in group.decisions %}
                        <div class="d-flex gap-3 {% if not loop.first %}border-top pt-2 mt-2{% endif %}">
                            <div class="flex-shrink-0 decision-reference text-nowrap">
                                {{ decision.meetingType.getName|trans }} {{ decision.meetingNumber }}.{{ decision.point }}.{{ decision.number }}
                            </div>
                            <div>
                                <span {% if decision.isAnnulled %}class="text-decoration-line-through text-muted"{% endif %}>
                                    {{ decision.getLocalisedContent(app.request.locale)|highlight_search(this.highlightTerms) }}
                                </span>
                                {% if decision.isAnnulled %}
                                    <span class="badge text-bg-danger ms-1">{{ 'Annulled'|trans }}</span>
                                {% endif %}

                                {# A virtual meeting says again what this meeting decided, which is what made the same
                                   decision turn up twice; its virtual counterparts are folded away underneath
                                   instead. #}
                                {% set virtual = this.getVirtualCounterpartsOf(decision) %}
                                {% if virtual is not empty %}
                                    {% set virtual_id = 'search-virtual-' ~ decision.meetingType.value ~ '-' ~ decision.meetingNumber ~ '-' ~ decision.point ~ '-' ~ decision.number %}
                                    <div class="mt-1">
                                        <button class="btn btn-link btn-sm p-0 collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#{{ virtual_id }}"
                                                aria-expanded="false" aria-controls="{{ virtual_id }}">
                                            {{ 'Also recorded in %count% virtual meeting|Also recorded in %count% virtual meetings'|trans({'%count%': virtual|length}) }}
                                            <span class="fas fa-chevron-down panel-collapse-chevron ms-1"
                                                  aria-hidden="true"></span>
                                        </button>
                                        <div class="collapse" id="{{ virtual_id }}">
                                            {% for counterpart in virtual %}
                                                <div class="d-flex gap-3 small text-muted mt-1">
                                                    <span class="flex-shrink-0 decision-reference text-nowrap">
                                                        {{ counterpart.meetingType.getName|trans }} {{ counterpart.meetingNumber }}.{{ counterpart.point }}.{{ counterpart.number }}
                                                    </span>
                                                    <span>{{ counterpart.getLocalisedContent(app.request.locale) }}</span>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% else %}
                        <p class="text-muted mb-0">
                            {{ 'No decisions of this meeting match your search.'|trans }}
                        </p>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <div class="panel">
                <div class="panel-body text-center text-muted py-4">
                    {{ 'No decisions match your search.'|trans }}
                </div>
            </div>
        {% endfor %}
    {% else %}
        <div class="panel">
            <div class="panel-body text-center text-muted py-4">
                {{ 'Start typing to search all decisions ever taken.'|trans }}
            </div>
        </div>
    {% endif %}
</div>
