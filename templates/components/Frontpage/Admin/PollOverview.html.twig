{% import 'partials/application/confirm-post-modal.html.twig' as modals %}

{# Read once: every mention re-runs the query's warm-up, and the modals below iterate the same rows again. #}
{% set polls = this.polls %}

<div {{ attributes }}>
    <div class="panel">
        <div class="panel-body">
            {% if this.totalCount == 0 %}
                <p class="text-muted mb-0">{{ 'No poll has been agreed to yet.'|trans }}</p>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>{{ 'Question'|trans }}</th>
                                <th>{{ 'Closes on'|trans }}</th>
                                <th>{{ 'Votes'|trans }}</th>
                                <th>{{ 'Status'|trans }}</th>
                                <th class="text-end">{{ 'Actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for poll in polls %}
                                <tr>
                                    <td>
                                        <a href="{{ path('poll/view', {'poll': poll.id}) }}">
                                            {{ poll.question|localise_text }}
                                        </a>
                                    </td>
                                    <td class="text-muted small">{{ poll.expiryDate|format_date(pattern: 'd MMM yyyy', locale: app.request.locale) }}</td>
                                    <td class="text-muted small">{{ poll.totalVotesCount }}</td>
                                    <td>
                                        {% if poll.isActive %}
                                            <span class="badge badge-success">{{ 'Running'|trans }}</span>
                                        {% else %}
                                            <span class="badge badge-secondary">{{ 'Closed'|trans }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        {% if poll.isActive %}
                                            <button type="button" class="btn btn-sm btn-outline-gewis-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modal-close-poll-{{ poll.id }}">
                                                {{ 'Close now'|trans }}
                                            </button>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {% include 'partials/application/pagination.html.twig' with {
                    'page': this.page,
                    'totalPages': this.totalPages,
                    'totalCount': this.totalCount,
                    'pageSize': this.pageSize,
                } only %}
            {% endif %}
        </div>
    </div>

    {# The modals live with the rows they belong to, so a page change takes the ones that left with it. #}
    {% for poll in polls %}
        {% if poll.isActive %}
            {{ modals.confirm_modal(
                'modal-close-poll-' ~ poll.id,
                path('admin/frontpage/polls/delete', {'poll': poll.id}),
                csrf_token('poll_delete-' ~ poll.id),
                'Close this poll now?'|trans,
                'The poll stops taking answers today. The question and the answers it was given stay in the archive.'|trans,
                'Close now'|trans,
                'gewis-primary',
            ) }}
        {% endif %}
    {% endfor %}
</div>
