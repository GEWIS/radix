<div {{ attributes }}>
    {% if this.totalCount > 0 %}
        <div class="panel">
            <div class="panel-heading">
                <h3>{{ 'Waiting to become downloadable'|trans }}</h3>
            </div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>{{ 'Course'|trans }}</th>
                                <th>{{ 'Document'|trans }}</th>
                                <th>{{ 'Status'|trans }}</th>
                                <th class="text-end">{{ 'Actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for document in this.documents %}
                                <tr>
                                    <td>
                                        <a href="{{ path('admin/education/courses/documents', {code: document.course.code}) }}">
                                            {{ document.course.code }}
                                        </a>
                                        <div class="text-muted small">{{ document.course.name }}</div>
                                    </td>
                                    <td>
                                        {{ document.type.label|trans }}
                                        <div class="text-muted small">{{ document.date|date('j M Y') }}</div>
                                    </td>
                                    <td>
                                        <span class="badge {{ document.flattenStatus.badgeClass }}">
                                            {{ document.flattenStatus.label|trans }}
                                        </span>
                                        {% if document.flattenError is not null %}
                                            <div class="text-muted small">{{ document.flattenError }}</div>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <form method="post" class="d-inline"
                                              action="{{ path('admin/education/documents/reprocess', {document: document.id}) }}">
                                            <input type="hidden" name="_csrf_token"
                                                   value="{{ csrf_token('education_document_reprocess-' ~ document.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">{{ 'Process again'|trans }}</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {% include 'partials/application/pagination.html.twig' with {
                    'page': this.page,
                    'totalPages': this.totalPages,
                    'totalCount': this.totalCount,
                    'pageSize': this.pageSize,
                } only %}
            </div>
        </div>
    {% endif %}
</div>
