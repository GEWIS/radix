{% extends 'layout-admin.html.twig' %}

{% import 'partials/application/confirm-post-modal.html.twig' as modals %}

{% block page_title %}{{ 'Overview'|trans|page_title }}{{ 'Photos'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item active" aria-current="page">
        <a href="{{ path('admin/photos/index') }}">
            {{ 'Photos'|trans }}
        </a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">
        {{ 'Overview'|trans }}
    </li>
{% endblock %}

{% block contents %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h3 class="mb-0">{{ 'Photo albums'|trans }}</h3>
        <div class="d-flex flex-wrap align-items-center gap-2">
            {% if years is not empty %}
                {% include 'partials/year-switcher.html.twig' with {
                    route: 'admin/photos/index',
                    year: year,
                    years: years,
                    all_years: false,
                } only %}
            {% endif %}
            <a href="{{ path('admin/photos/albums_create') }}" class="btn btn-gewis-primary">
                <span class="fas fa-plus"></span> {{ 'Create album'|trans }}
            </a>
        </div>
    </div>

    {% if albums is empty %}
        <p class="text-muted">{{ 'There are no albums yet.'|trans }}</p>
    {% else %}
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xxl-6 g-3 mb-4">
            {% for album in albums %}
                {% include 'partials/photo/admin/album-card.html.twig' with {
                    'album': album,
                    'subAlbumCount': cardCounts.subAlbums[album.id] ?? 0,
                    'photoCount': cardCounts.photos[album.id] ?? 0,
                } only %}
            {% endfor %}
        </div>

        {% for album in albums %}
                {% set album_delete_body %}
                    {{ 'Are you sure you want to delete this album?'|trans }}
                    <span class="fw-semibold d-block mt-1">{{ album.name }}</span>
                    {% if album.albumCount > 0 or album.getPhotoCount(false) > 0 %}
                        <span class="text-danger small d-block mt-2">
                            <span class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></span>
                            {{ 'Its sub-albums and photos are deleted as well. This cannot be undone.'|trans }}
                        </span>
                    {% endif %}
                {% endset %}
                {{ modals.confirm_modal(
                    'delete-album-' ~ album.id,
                    path('admin/photos/albums_delete', {album: album.id}),
                    csrf_token('photo_album_delete-' ~ album.id),
                    'Delete album'|trans,
                    album_delete_body,
                    'Delete album'|trans,
                    'danger',
                ) }}
        {% endfor %}
    {% endif %}
{% endblock %}
