{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ 'Course material'|trans|page_title }}{{ 'Education'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'Education'|trans }}</li>
{% endblock %}

{% block contents %}
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h2 class="mb-1">{{ 'Course material'|trans }}</h2>
            <p class="text-body-secondary mb-0">{{ 'Publish uploads, fix what they say, and keep the archive tidy.'|trans }}</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('admin/education/courses/add') }}" class="btn btn-outline-secondary">
                <span class="fas fa-plus" aria-hidden="true"></span> {{ 'Add a course'|trans }}
            </a>
            <a href="{{ path('admin/education/documents/upload') }}" class="btn btn-gewis-primary">
                <span class="fas fa-upload" aria-hidden="true"></span> {{ 'Upload documents'|trans }}
            </a>
        </div>
    </div>

    <div class="row row-cols-2 row-cols-md-4 g-2 mb-3">
        {% for tile in [
            {'value': counts.courses, 'label': 'Courses tracked'|trans},
            {'value': counts.documents, 'label': 'Published documents'|trans},
            {'value': unprocessedCount, 'label': 'Not downloadable yet'|trans},
            {'value': counts.coursesWithoutMaterial, 'label': 'Courses with nothing'|trans},
        ] %}
            <div class="col">
                <div class="panel my-0 h-100">
                    <div class="panel-body">
                        <span class="education-stat-value d-block">{{ tile.value }}</span>
                        <span class="education-stat-label">{{ tile.label }}</span>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <twig:Education:Admin:UnprocessedDocumentOverview />

    {{ component('Education:Admin:CourseOverview') }}
{% endblock %}
