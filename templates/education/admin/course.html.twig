{% extends 'layout-admin.html.twig' %}

{% import 'partials/application/confirm-post-modal.html.twig' as modals %}

{% set documents = course.getDocuments %}

{% block page_title %}{{ course.code|page_title }}{{ 'Education'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item"><a href="{{ path('admin/education/index') }}">{{ 'Education'|trans }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ course.code }}</li>
{% endblock %}

{% block contents %}
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h2 class="mb-1">{{ course.code }} &middot; {{ course.name }}</h2>
            <p class="text-body-secondary mb-0">
                {{ '%count% document|%count% documents'|trans({'%count%': documents|length}) }}
                {% if course.getSimilarCourses is not empty %}
                    &middot;
                    {{ 'similar to'|trans }}
                    {% for similar in course.getSimilarCourses %}
                        <a href="{{ path('admin/education/courses/documents', {code: similar.code}) }}">{{ similar.code }}</a>{{ not loop.last ? ',' }}
                    {% endfor %}
                {% endif %}
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('education/course', {code: course.code}) }}" class="btn btn-outline-secondary">
                <span class="fas fa-arrow-up-right-from-square" aria-hidden="true"></span> {{ 'View on the site'|trans }}
            </a>
            <a href="{{ path('admin/education/courses/edit', {code: course.code}) }}" class="btn btn-outline-secondary">
                {{ 'Edit course'|trans }}
            </a>
            <button type="button" class="btn btn-outline-danger"
                    data-bs-toggle="modal" data-bs-target="#modal-delete-course">
                {{ 'Remove course'|trans }}
            </button>
        </div>
    </div>

    <div class="panel mt-0">
        <div class="panel-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>{{ 'Document'|trans }}</th>
                            <th>{{ 'Date'|trans }}</th>
                            <th>{{ 'Language'|trans }}</th>
                            <th>{{ 'Pages'|trans }}</th>
                            <th>{{ 'Status'|trans }}</th>
                            <th class="text-end">{{ 'Actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for document in documents %}
                            {% set type = document.type %}
                            <tr>
                                <td>
                                    {{ 'summary' == type.value ? type.label|trans : document.examType.label|trans }}
                                    {% if 'summary' == type.value and document.author is not null %}
                                        <div class="text-muted small">{{ document.author }}</div>
                                    {% endif %}
                                    {% if document.scanned %}
                                        <span class="badge badge-tag">{{ 'Scanned'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ document.date|date('j M Y') }}</td>
                                <td>{{ document.language.label|trans }}</td>
                                <td>{{ document.getPageCount }}</td>
                                <td>
                                    <span class="badge {{ document.flattenStatus.badgeClass }}">
                                        {{ document.flattenStatus.label|trans }}
                                    </span>
                                    {% if document.flattenError is not null %}
                                        <div class="text-muted small">{{ document.flattenError }}</div>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <form method="post" class="d-inline"
                                          action="{{ path('admin/education/documents/reprocess', {document: document.id}) }}">
                                        <input type="hidden" name="_csrf_token"
                                               value="{{ csrf_token('education_document_reprocess-' ~ document.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">{{ 'Process again'|trans }}</button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modal-delete-document-{{ document.id }}">
                                        {{ 'Remove'|trans }}
                                    </button>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    {{ 'Nothing has been filed under this course yet.'|trans }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {{ modals.confirm_modal(
        'modal-delete-course',
        path('admin/education/courses/delete', {code: course.code}),
        csrf_token('education_course_delete-' ~ course.code),
        'Remove this course?'|trans,
        '%code% and every document filed under it are removed, along with the files behind them. This cannot be undone.'|trans({'%code%': course.code}),
        'Remove'|trans,
        'danger',
    ) }}

    {% for document in documents %}
        {{ modals.confirm_modal(
            'modal-delete-document-' ~ document.id,
            path('admin/education/documents/delete', {document: document.id}),
            csrf_token('education_document_delete-' ~ document.id),
            'Remove this document?'|trans,
            'It disappears from %code% and the files behind it are removed. This cannot be undone.'|trans({'%code%': course.code}),
            'Remove'|trans,
            'danger',
        ) }}
    {% endfor %}
{% endblock %}
