{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ 'Overview'|trans|page_title }}{{ 'Polls'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/frontpage/polls/index') }}">{{ 'Polls'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Overview'|trans }}</li>
{% endblock %}

{% block contents %}
    <div class="row mb-3">
        <div class="col-md-12 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="mb-0">{{ 'Polls'|trans }}</h2>
            <a href="{{ path('admin/frontpage/polls/approvals/index') }}" class="btn btn-outline-gewis-primary">
                {{ 'Awaiting review'|trans }}
                <span class="badge badge-gewis-primary">{{ awaitingReview }}</span>
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <twig:Frontpage:Admin:PollOverview />
        </div>
    </div>
{% endblock %}
