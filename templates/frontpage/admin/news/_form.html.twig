{{ form_start(form, {'method': 'POST', 'attr': {'novalidate': 'novalidate'}}) }}
{{ form_errors(form) }}

<div class="row">
    <div class="col-md-8">
        <div class="panel">
            <div class="panel-heading">
                <h3>{{ 'General'|trans }}</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.date) }}</div>
                    <div class="col-md-6">{{ form_row(form.category) }}</div>
                </div>
                {{ form_row(form.pinned) }}
            </div>
        </div>

        <div class="panel">
            <div class="panel-heading">
                <h3>{{ 'Text'|trans }}</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    {% for language in [
                        {'code': 'nl', 'label': 'Dutch'|trans, 'title': form.title.valueNL, 'content': form.content.valueNL},
                        {'code': 'en', 'label': 'English'|trans, 'title': form.title.valueEN, 'content': form.content.valueEN},
                    ] %}
                        <div class="col-md-6">
                            <div class="mb-2">
                                <span class="flag-icon flag-icon-{{ language.code }}"></span> {{ language.label }}
                            </div>
                            {{ form_row(language.title, {'label': 'Title'|trans}) }}
                            {{ form_row(language.content, {
                                'label': 'Content'|trans,
                                'attr': {
                                    'data-controller': 'markdown-editor',
                                    'data-markdown-editor-language-value': app.request.locale,
                                },
                            }) }}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-gewis-primary">{{ 'Save'|trans }}</button>
            <a href="{{ path('admin/frontpage/news/index') }}" class="btn btn-secondary">{{ 'Cancel'|trans }}</a>
        </div>
    </div>
</div>

{{ form_end(form) }}
