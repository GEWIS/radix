{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ 'Overview'|trans|page_title }}{{ 'News'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/frontpage/news/index') }}">{{ 'News'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Overview'|trans }}</li>
{% endblock %}

{% block contents %}
    <div class="row mb-3">
        <div class="col-md-12 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="mb-0">{{ 'News'|trans }}</h2>
            <a href="{{ path('admin/frontpage/news/create') }}" class="btn btn-gewis-primary">
                <span class="fas fa-plus"></span> {{ 'Write news'|trans }}
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <twig:Frontpage:Admin:NewsOverview />
        </div>
    </div>
{% endblock %}
