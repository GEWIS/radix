{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ 'New page'|trans|page_title }}{{ 'Pages'|trans|page_title }}{{ parent() }}{% endblock %}

{# The cookie that lets the browser listen is minted in the base layout from every topic named here. #}
{% block realtime_extra_topics %}{{ imageTopic }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {# The editor draws itself with this; without it the toolbar and the editing area render unstyled. #}
    <link rel="stylesheet" href="{{ asset('styles/ckeditor5/ckeditor5.css') }}">
{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/frontpage/pages/index') }}">{{ 'Pages'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'New page'|trans }}</li>
{% endblock %}

{% block contents %}
    <h2 class="mb-3">{{ 'New page'|trans }}</h2>
    {% include 'frontpage/admin/pages/_form.html.twig' %}

    {# Outside the form: nothing in the dialog belongs to what the form submits. The confirmation follows it so that
       it is the one on top. #}
    {% include 'partials/frontpage/page-image-browser.html.twig' %}
    {% include 'partials/application/confirm-modal.html.twig' %}
{% endblock %}
