{% extends 'layout-admin.html.twig' %}

{% set abbr = meeting.type.getName|trans %}

{% block page_title %}{{ (abbr ~ ' ' ~ meeting.number)|page_title }}{{ 'Meetings'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/meetings/index') }}">{{ 'Meetings'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ abbr }} {{ meeting.number }}</li>
{% endblock %}

{% block contents %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="mb-0">{{ abbr }} {{ meeting.number }} &middot; {{ meeting.type.label|trans }}</h2>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('decision_export_index') }}" class="btn btn-outline-secondary">
                <span class="fas fa-file-arrow-down" aria-hidden="true"></span>
                {{ 'Export a decision list'|trans }}
            </a>
            <a href="{{ path('meetings/view', {'type': type, 'number': number}) }}" class="btn btn-outline-secondary">
                <span class="fas fa-eye" aria-hidden="true"></span>
                {{ 'View as member'|trans }}
            </a>
        </div>
    </div>
    <p class="text-muted mb-3">{{ meeting.date|format_date('full') }}</p>

    {# One page about one meeting, in the order it is kept in: what was decided, then what was filed alongside it.
       Both belong to whoever keeps the register, so neither is a half of the page that appears for somebody else --
       a reader who may not change the record simply has no management panel to be shown. #}
    {# A meeting the projection knows and the ledger does not has no decisions to show; it still has its documents. #}
    {% if decisions is defined %}
        {% include 'decision/admin/meetings/decisions.html.twig' %}
    {% endif %}

    {% if is_granted('ROLE_DATABASE_ADMIN') %}
        {{ component('Decision:Admin:MeetingManage', {'type': type, 'number': number}) }}
    {% endif %}

    {% include 'partials/application/confirm-modal.html.twig' %}
{% endblock %}
