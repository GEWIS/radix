{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ 'Overview'|trans|page_title }}{{ 'Bodies'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/bodies/index') }}">{{ 'Bodies'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Overview'|trans }}</li>
{% endblock %}

{% block contents %}
    <div class="row mb-3">
        <div class="col-md-12">
            <h2 class="mb-1">{{ 'Bodies'|trans }}</h2>
            <p class="text-muted mb-0">
                {{ 'Pick a body to write its page. Changes are shown on the website once the board has approved them.'|trans }}
            </p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <twig:Decision:Admin:BodyPageOverview />
        </div>
    </div>
{% endblock %}
