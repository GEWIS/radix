{% extends 'layout-admin.html.twig' %}

{% import 'partials/application/form-flow.html.twig' as flow %}

{% block page_title %}{{ 'Edit'|trans|page_title }}{{ organ.getAbbr|page_title }}{{ 'Bodies'|trans|page_title }}{{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/ckeditor5/ckeditor5.css') }}">
{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/bodies/index') }}">{{ 'Bodies'|trans }}</a>
    </li>
    <li class="breadcrumb-item">
        <a href="{{ path('admin/bodies/view', {'organ': organ.getId}) }}">{{ organ.getAbbr }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Edit'|trans }}</li>
{% endblock %}

{% block contents %}
    {% set live = information.getLiveRevision %}
    {% set step = form_flow_current_step(form) %}

    <div class="row mb-3">
        <div class="col-md-12">
            <h2 class="mb-1">{{ organ.getName }} <small class="text-muted">({{ organ.getAbbr }})</small></h2>
            <p class="text-muted mb-0">
                {{ 'Saving keeps this as a draft. It only reaches the website once the board approves it.'|trans }}
            </p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div data-controller="edit-lock"
                 data-edit-lock-ping-url-value="{{ path('admin/bodies/edit_ping', {'organ': organ.getId}) }}"
                 data-edit-lock-release-url-value="{{ path('admin/bodies/edit_release', {'organ': organ.getId}) }}"
                 data-edit-lock-csrf-token-value="{{ csrf_token('body_edit_lock') }}"
                 data-edit-lock-lost-message-value="{{ 'You no longer hold the edit lock; it was taken over or expired. Reload the page to continue editing.'|trans }}">
                {{ form_start(form) }}
                {{ form_errors(form) }}

                {{ flow.stepper(form) }}

                {% if 'page' == step %}
                    {% set fields = form.page %}
                    <div class="panel" data-controller="localised-fields">
                        <div class="panel-heading">
                            <h3>{{ 'Page'|trans }}</h3>
                        </div>
                        <div class="panel-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_row(fields.languageDutch, {
                                            'label': '<span class="flag-icon flag-icon-nl"></span> ' ~ ('Dutch'|trans),
                                            'label_html': true,
                                            'attr': {
                                                'data-localised-fields-target': 'dutchToggle',
                                                'data-action': 'localised-fields#apply',
                                            },
                                        }) }}
                                    </div>
                                    <hr>
                                    {{ form_row(fields.shortDescriptionNL, {
                                        'attr': {'data-localised-fields-target': 'dutch'},
                                    }) }}
                                    {{ form_row(fields.descriptionNL, {
                                        'attr': {
                                            'data-localised-fields-target': 'dutch',
                                            'data-controller': 'markdown-editor',
                                            'data-markdown-editor-language-value': app.request.locale,
                                        },
                                    }) }}
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_row(fields.languageEnglish, {
                                            'label': '<span class="flag-icon flag-icon-en"></span> ' ~ ('English'|trans),
                                            'label_html': true,
                                            'attr': {
                                                'data-localised-fields-target': 'englishToggle',
                                                'data-action': 'localised-fields#apply',
                                            },
                                        }) }}
                                    </div>
                                    <hr>
                                    {{ form_row(fields.shortDescriptionEN, {
                                        'attr': {'data-localised-fields-target': 'english'},
                                    }) }}
                                    {{ form_row(fields.descriptionEN, {
                                        'attr': {
                                            'data-localised-fields-target': 'english',
                                            'data-controller': 'markdown-editor',
                                            'data-markdown-editor-language-value': app.request.locale,
                                        },
                                    }) }}
                                </div>
                            </div>
                        </div>
                    </div>
                {% elseif 'contact' == step %}
                    {% set fields = form.contact %}
                    <div class="panel">
                        <div class="panel-heading">
                            <h3>{{ 'Contact details'|trans }}</h3>
                        </div>
                        <div class="panel-body">
                            <div class="row">
                                <div class="col-md-6">{{ form_row(fields.email) }}</div>
                                <div class="col-md-6">{{ form_row(fields.website) }}</div>
                            </div>
                        </div>
                    </div>

                    {% include 'partials/application/social-links-form.html.twig' with {
                        'field': fields.socialLinks,
                    } only %}
                {% else %}
                    {% set fields = form.images %}
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="panel mt-0 h-100">
                                <div class="panel-heading">
                                    <h3>{{ 'Logo'|trans }}</h3>
                                </div>
                                <div class="panel-body">
                                    <p class="text-muted">
                                        {{ 'What your body is recognised by on an overview card.'|trans }}
                                    </p>
                                    {% include 'partials/decision/organ-image-field.html.twig' with {
                                        'fileField': fields.logoFile,
                                        'cropField': fields.logoCropData,
                                        'source': revision.getLogoSource,
                                        'crop': revision.getLogoCrop,
                                        'live': live ? live.getLogoPath : null,
                                        'sourceWidth': logoSourceWidth,
                                        'ratio': constant('App\\Form\\Decision\\OrganPage\\ImagesStepType::LOGO_RATIO'),
                                        'shape': 'logo',
                                    } only %}
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="panel mt-0 h-100">
                                <div class="panel-heading">
                                    <h3>{{ 'Page banner'|trans }}</h3>
                                </div>
                                <div class="panel-body">
                                    <p class="text-muted">
                                        {{ 'The wide strip your own page leads with, much wider than it is tall.'|trans }}
                                    </p>
                                    {% include 'partials/decision/organ-image-field.html.twig' with {
                                        'fileField': fields.bannerFile,
                                        'cropField': fields.bannerCropData,
                                        'source': revision.getBannerSource,
                                        'crop': revision.getBannerCrop,
                                        'live': live ? live.getBannerPath : null,
                                        'sourceWidth': bannerSourceWidth,
                                        'ratio': constant('App\\Form\\Decision\\OrganPage\\ImagesStepType::BANNER_RATIO'),
                                        'shape': 'banner',
                                    } only %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                {{ flow.navigation(form, path('admin/bodies/view', {'organ': organ.getId})) }}
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
