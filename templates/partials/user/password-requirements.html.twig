{# Mirrors the constraints in `App\Validator\User\PasswordPolicy`; keep the two in sync. #}
{% set minLength = constant('App\\Validator\\User\\PasswordPolicy::MIN_LENGTH') %}
{% set maxLength = constant('App\\Validator\\User\\PasswordPolicy::MAX_LENGTH') %}
<div class="alert alert-info">
    <button type="button"
            class="panel-collapse-toggle collapsed text-reset d-flex justify-content-between align-items-center gap-2 w-100 border-0 bg-transparent text-start p-0"
            data-bs-toggle="collapse" data-bs-target="#password-requirements"
            aria-expanded="false" aria-controls="password-requirements">
        <span>
            <span class="fas fa-circle-info"></span>
            <strong>{{ 'Password requirements'|trans }}</strong>
        </span>
        <span class="fa-solid fa-chevron-down panel-collapse-chevron"></span>
    </button>
    <div class="collapse" id="password-requirements">
        <ul class="mt-2 mb-0 ps-3">
            <li>
                {{ 'Between %min% and %max% characters.'|trans({
                    '%min%': minLength,
                    '%max%': maxLength,
                }) }}
            </li>
            <li>
                {{ 'Strong: we count how hard it is to guess, not whether it has a capital, a digit, and a symbol. Common words, names, dates, and sequences such as <code>qwerty</code> or <code>Passw0rd!</code> score low.'|trans|raw }}
            </li>
            <li>
                {{ 'Not found in a known data breach.'|trans }}
            </li>
        </ul>
        <hr class="my-3">
        <p class="mb-2">
            {{ 'A password manager is the best option: it generates a random password, stores it, and fills it in, so every account gets a different one and you never have to type it.'|trans }}
        </p>
        <p class="mb-0">
            {{ 'If you would rather remember it, take several random words and add characters that are not words. Take the words at random, not a phrase about yourself. %example% has leaked, so pick your own. See %link%.'|trans({
                '%example%': '<code>correct horse battery staple</code>',
                '%link%': '<a href="https://xkcd.com/936/" target="_blank" rel="noopener">xkcd.com/936</a>',
            })|raw }}
        </p>
    </div>
</div>
