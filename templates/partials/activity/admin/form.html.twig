{#
    The activity form. Nothing is written before the last step is accepted.
#}
{% import 'partials/application/form-flow.html.twig' as flow %}

{% set step = form_flow_current_step(form) %}

{{ form_start(form) }}
{{ form_errors(form) }}

{{ flow.stepper(form) }}

{% if 'general' == step %}
    {% set fields = form.general %}
    <div class="row">
        <div class="col-md-6">
            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'Organisers'|trans }}</h3>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-6">{{ form_row(fields.organId) }}</div>
                        <div class="col-md-6">{{ form_row(fields.companyId) }}</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'Date and time'|trans }}</h3>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-6">{{ form_row(fields.beginTime) }}</div>
                        <div class="col-md-6">{{ form_row(fields.endTime) }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'Category and labels'|trans }}</h3>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-4">{{ form_row(fields.category) }}</div>
                        <div class="col-md-8">{{ form_row(fields.labelIds) }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'Facilities'|trans }}</h3>
                </div>
                <div class="panel-body">
                    {{ form_row(fields.requireGEFLITST) }}
                    {{ form_row(fields.requireZettle) }}
                </div>
            </div>
        </div>
    </div>
{% elseif 'details' == step %}
    {% set fields = form.details %}
    <div class="row" data-controller="localised-fields">
        <div class="col-md-12">
            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'Information'|trans }}</h3>
                    <p class="text-muted small mb-0">
                        {{ 'Enable Dutch and/or English and fill in the fields below. At least one language must be used.'|trans }}
                    </p>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(fields.languageDutch, {
                                'label': '<span class="flag-icon flag-icon-nl"></span> ' ~ ('Dutch'|trans),
                                'label_html': true,
                                'attr': {
                                    'data-localised-fields-target': 'dutchToggle',
                                    'data-action': 'change->localised-fields#apply',
                                },
                            }) }}
                            <hr>
                            {{ form_row(fields.nameNL, {'attr': {'data-localised-fields-target': 'dutch'}}) }}
                            {{ form_row(fields.locationNL, {'attr': {'data-localised-fields-target': 'dutch'}}) }}
                            {{ form_row(fields.costsNL, {'attr': {'data-localised-fields-target': 'dutch'}}) }}
                            {{ form_row(fields.descriptionNL, {'attr': {'data-localised-fields-target': 'dutch', 'data-controller': 'markdown-editor', 'data-markdown-editor-language-value': app.request.locale}}) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(fields.languageEnglish, {
                                'label': '<span class="flag-icon flag-icon-en"></span> ' ~ ('English'|trans),
                                'label_html': true,
                                'attr': {
                                    'data-localised-fields-target': 'englishToggle',
                                    'data-action': 'change->localised-fields#apply',
                                },
                            }) }}
                            <hr>
                            {{ form_row(fields.nameEN, {'attr': {'data-localised-fields-target': 'english'}}) }}
                            {{ form_row(fields.locationEN, {'attr': {'data-localised-fields-target': 'english'}}) }}
                            {{ form_row(fields.costsEN, {'attr': {'data-localised-fields-target': 'english'}}) }}
                            {{ form_row(fields.descriptionEN, {'attr': {'data-localised-fields-target': 'english', 'data-controller': 'markdown-editor', 'data-markdown-editor-language-value': app.request.locale}}) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% else %}
    <div class="row">
        <div class="col-md-12">
            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'Sign-up lists'|trans }}</h3>
                    <p class="text-muted small mb-0">
                        {{ 'Optional. A sign-up list with subscribers can no longer be changed structurally.'|trans }}
                    </p>
                </div>
                <div class="panel-body">
                    {{ form_widget(form.signupLists.signupLists) }}
                </div>
            </div>
        </div>
    </div>
{% endif %}

{{ flow.navigation(form, path('admin/activities/index')) }}
{{ form_end(form) }}
