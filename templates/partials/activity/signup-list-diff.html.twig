{#
    A sign-up list is a repeated sub-entity with fields of its own, which the flat RevisionSection /
    RevisionField model a describer builds cannot express, so the activity module says it here instead.

    {% include 'partials/activity/signup-list-diff.html.twig' with {'signupListDiff': signupListDiff} only %}

    The page is responsible for emitting `diff_styles()` into its stylesheets block once.
#}
{% import 'partials/application/revision-diff.html.twig' as diffmacro %}
{% import _self as listmacro %}

{#
    One setting of a sign-up list, with what it was before struck through when the revision changed it. A setting
    that is not in use in either revision is left out entirely, so a list that does not use, say, a draw cutoff does
    not carry an empty line about one.
#}
{% macro value_row(label, old, new) %}
    {% set newText = new is null ? '' : new|trim %}
    {% set oldText = old is null ? '' : old|trim %}
    {% if '' != newText or '' != oldText %}
        <div>
            <span class="text-muted">{{ label }}:</span>
            {{ '' != newText ? newText : 'None'|trans }}
            {% if '' != oldText and oldText != newText %}<del class="text-danger">{{ oldText }}</del>{% endif %}
        </div>
    {% endif %}
{% endmacro %}

{# A priority order as the board reads it, best served first. Empty when the list does not rank on it. #}
{% macro tier_order(order) %}{{ order is null ? '' : order|map(tier => tier|trans)|join(' > ') }}{% endmacro %}

{# The guaranteed roles as "Driver (4), Skipper (2)". Empty when the list guarantees none. #}
{% macro roles(roles) %}{{ roles is null ? '' : roles|map(role => role.name ~ ' (' ~ role.minimum ~ ')')|join(', ') }}{% endmacro %}

{% macro signup_list_body(list, previous) %}
    {% import 'partials/application/revision-diff.html.twig' as diffmacro %}
    {% import _self as listmacro %}
    <div class="small mb-1">
        <span class="text-muted">{{ 'Opens'|trans }}:</span> {{ list.openDate|date('M j, Y H:i') }}
        {% if previous is not null and previous.openDate != list.openDate %}
            <del class="text-danger">{{ previous.openDate|date('M j, Y H:i') }}</del>
        {% endif %}
        <span class="text-muted ms-2">{{ 'Closes'|trans }}:</span> {{ list.closeDate|date('M j, Y H:i') }}
        {% if previous is not null and previous.closeDate != list.closeDate %}
            <del class="text-danger">{{ previous.closeDate|date('M j, Y H:i') }}</del>
        {% endif %}
    </div>

    {% set flags %}
        {{ diffmacro.flag('Members only'|trans, previous ? previous.onlyGEWIS : null, list.onlyGEWIS) }}
        {{ diffmacro.flag('Show sign-up count'|trans, previous ? previous.displaySubscribedNumber : null, list.displaySubscribedNumber) }}
        {{ diffmacro.flag('Limited capacity'|trans, previous ? previous.limitedCapacity : null, list.limitedCapacity) }}
        {{ diffmacro.flag('Promoted'|trans, previous ? previous.promoted : null, list.promoted) }}
    {% endset %}
    {% if flags|trim is not empty %}
        <div class="mb-1">{{ flags }}</div>
    {% endif %}

    {% set allocation %}
        {% set capacityNow = list.limitedCapacity ? list.capacity : 'No limit'|trans %}
        {% set capacityWas = previous is null ? null : (previous.limitedCapacity ? previous.capacity : 'No limit'|trans) %}
        {{ listmacro.value_row('Capacity'|trans, capacityWas, capacityNow) }}

        {% if list.limitedCapacity %}
            {{ listmacro.value_row('Allocation method'|trans, previous is null or not previous.limitedCapacity ? null : previous.allocationMethod|trans, list.allocationMethod|trans) }}

            {% if 'conditional-draw' == list.allocationMethod.value %}
                {{ listmacro.value_row('When to draw'|trans, previous is null or previous.drawCutoffRule is null ? null : previous.drawCutoffRule|trans, list.drawCutoffRule is null ? null : list.drawCutoffRule|trans) }}
                {% if list.drawCutoffAt is not null %}
                    {{ listmacro.value_row('Draw cutoff moment'|trans, previous is null or previous.drawCutoffAt is null ? null : previous.drawCutoffAt|date('M j, Y H:i'), list.drawCutoffAt|date('M j, Y H:i')) }}
                {% endif %}
                {% if list.drawAfterDurationHours is not null %}
                    {{ listmacro.value_row('Draw after being open for (hours)'|trans, previous is null ? null : previous.drawAfterDurationHours, list.drawAfterDurationHours) }}
                {% endif %}
            {% endif %}

            {% if 'external-party' == list.allocationMethod.value %}
                {{ listmacro.value_row('External party policy URL'|trans, previous is null ? null : previous.externalPolicyUrl, list.externalPolicyUrl) }}
            {% endif %}

            {% if 'custom' == list.allocationMethod.value %}
                {{ listmacro.value_row('Describe the allocation method'|trans, previous is null ? null : previous.customMethodDescription, list.customMethodDescription) }}
            {% endif %}

            {{ listmacro.value_row('Membership priority'|trans, listmacro.tier_order(previous is null ? null : previous.membershipTierOrder), listmacro.tier_order(list.membershipTierOrder)) }}
            {% if list.membershipPriorityMode is not null %}
                {{ listmacro.value_row('How the membership order is applied'|trans, previous is null or previous.membershipPriorityMode is null ? null : previous.membershipPriorityMode|trans, list.membershipPriorityMode|trans) }}
            {% endif %}
            {% if list.membershipPriorityMode is not null and 'reserved-seats' == list.membershipPriorityMode.value %}
                {{ listmacro.value_row('Seats held for members'|trans, previous is null ? null : previous.membershipSeatsMember, list.membershipSeatsMember) }}
                {{ listmacro.value_row('Seats held for graduates'|trans, previous is null ? null : previous.membershipSeatsGraduate, list.membershipSeatsGraduate) }}
                {{ listmacro.value_row('Seats held for non-members'|trans, previous is null ? null : previous.membershipSeatsNonMember, list.membershipSeatsNonMember) }}
            {% endif %}
            {{ listmacro.value_row('Study phase priority'|trans, listmacro.tier_order(previous is null ? null : previous.programTypeOrder), listmacro.tier_order(list.programTypeOrder)) }}
            {{ listmacro.value_row('Cohort priority'|trans, listmacro.tier_order(previous is null ? null : previous.cohortTierOrder), listmacro.tier_order(list.cohortTierOrder)) }}
            {{ listmacro.value_row('Seats held for the organising body'|trans, previous is null ? null : previous.organisingCommitteeSeats, list.organisingCommitteeSeats) }}
            {{ listmacro.value_row('Guaranteed roles'|trans, listmacro.roles(previous is null ? null : previous.roles), listmacro.roles(list.roles)) }}
        {% endif %}
    {% endset %}
    {% if allocation|trim is not empty %}
        <div class="small mb-2">{{ allocation }}</div>
    {% endif %}

    {% set previousFields = previous is not null ? previous.fields.values : [] %}
    {% if list.fields|length > 0 or previousFields|length > 0 %}
        <ul class="list-unstyled small mb-0">
            {% for field in list.fields %}
                {% set prevField = previousFields[loop.index0] ?? null %}
                <li class="mb-1">
                    {% if previous is not null and prevField is null %}
                        <span class="badge badge-success">{{ 'New field'|trans }}</span>
                    {% endif %}
                    <strong>
                        {{ diff(prevField ? prevField.name.valueNL : null, field.name.valueNL) }}
                        <span class="text-muted">/</span>
                        {{ diff(prevField ? prevField.name.valueEN : null, field.name.valueEN) }}
                    </strong>
                    <span class="badge badge-secondary">{{ field.type|trans }}</span>
                    {% if prevField is not null and prevField.type != field.type %}
                        <span class="text-muted">({{ 'was'|trans }} {{ prevField.type|trans }})</span>
                    {% endif %}
                    {% if field.isSensitive %}<span class="badge badge-warning">{{ 'Sensitive'|trans }}</span>{% endif %}
                    {% if 'number' == field.type.value and (field.minimumValue is not null or field.maximumValue is not null) %}
                        <span class="text-muted">[{{ field.minimumValue ?? '...' }}, {{ field.maximumValue ?? '...' }}]</span>
                    {% endif %}
                    {% if field.options|length > 0 %}
                        <div>{{ field.options|map(option => option.value|localise_text)|join(', ') }}</div>
                    {% endif %}
                </li>
            {% endfor %}
            {% for prevField in previousFields|slice(list.fields|length) %}
                <li class="mb-1 text-danger">
                    <span class="badge badge-danger">{{ 'Removed field'|trans }}</span>
                    <s>{{ prevField.name|localise_text }}</s>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <span class="text-muted small">{{ 'No custom fields.'|trans }}</span>
    {% endif %}
{% endmacro %}

<div class="panel">
    <div class="panel-heading">
        <h3>{{ 'Sign-up lists'|trans }}</h3>
    </div>
    <div class="panel-body">
        {% if signupListDiff.present is empty and signupListDiff.removed is empty %}
            <p class="text-muted small mb-0">{{ 'This activity has no sign-up lists.'|trans }}</p>
        {% else %}
            <div class="d-flex flex-column gap-3">
                {% for entry in signupListDiff.present %}
                    <div class="border rounded p-3">
                        {% if entry.previous is null %}
                            <div class="mb-2"><span class="badge badge-success">{{ 'New list'|trans }}</span></div>
                            {{ diffmacro.localised_flag_diff(null, entry.list.name) }}
                        {% else %}
                            {{ diffmacro.localised_flag_diff(entry.previous.name, entry.list.name) }}
                        {% endif %}
                        {{ listmacro.signup_list_body(entry.list, entry.previous) }}
                    </div>
                {% endfor %}
                {% for list in signupListDiff.removed %}
                    <div class="border rounded p-3 opacity-75">
                        <div class="mb-2"><span class="badge badge-danger">{{ 'Removed list'|trans }}</span></div>
                        {{ diffmacro.localised_flag_diff(null, list.name, struck=true) }}
                        {{ listmacro.signup_list_body(list) }}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
