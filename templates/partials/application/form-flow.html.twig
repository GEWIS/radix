{#
    The header and the buttons of a form flow ({@see App\Form\Application\Flow\AbstractStepperFlowType}).
    Everything that leaves a step unfinished carries `formnovalidate`, or the browser refuses to go back over
    a field that has not been filled in yet.

        {% import 'partials/application/form-flow.html.twig' as flow %}
        {{ flow.stepper(form) }}
        ...the current step...
        {{ flow.navigation(form) }}
#}
{% macro goto(form, step, label, attributes) %}
    <button type="submit" formnovalidate
            name="{{ form.goto.vars.full_name }}" value="{{ step }}"
            {% for name, value in attributes|default({}) %}{{ name }}="{{ value }}" {% endfor %}>{{ label }}</button>
{% endmacro %}

{% macro stepper(form) %}
    {% import _self as self %}
    {% set stepper = form.vars.stepper %}
    {# The jump button is drawn by hand, once per step it can reach, so form_end() must not emit it as well. #}
    {% do form.goto.setRendered %}
    <ol class="form-stepper" role="tablist">
        {% for step in stepper.top %}
            <li class="form-stepper__step" role="presentation">
                {% if 'current' != step.state and step.reachable and form.goto is defined %}
                    {{ self.goto(form, step.name, self.tab_content(step), {
                        'class': 'form-stepper__btn' ~ ('complete' == step.state ? ' is-complete' : ''),
                        'role': 'tab',
                    }) }}
                {% else %}
                    <span class="form-stepper__btn{{ 'current' == step.state ? ' active' }}" role="tab"
                          {% if 'current' == step.state %}aria-current="step"{% endif %}>
                        {{ self.tab_content(step) }}
                    </span>
                {% endif %}
            </li>
        {% endfor %}
    </ol>

    {% if stepper.group is not null %}
        {{ self.group_bar(form, stepper.group) }}
    {% endif %}
{% endmacro %}

{% macro tab_content(step) %}
    <span class="form-stepper__num">{{ step.position }}</span>
    <span class="form-stepper__label">{{ step.label|trans }}</span>
{% endmacro %}

{% macro group_bar(form, group) %}
    {% import _self as self %}
    <div class="d-flex align-items-center gap-3 flex-wrap mb-4 pt-3 border-top">
        <div class="dropdown">
            <button type="button" class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2 text-start" data-bs-toggle="dropdown"
                    aria-expanded="false">
                {% if group.number is not null %}
                    <span class="form-stepper-badge">{{ group.number }}</span>
                {% endif %}
                <span class="d-flex flex-column overflow-hidden lh-sm">
                    <span class="small fw-bold text-truncate">{{ group.label }}</span>
                    <span class="small text-muted">
                        {{ '%position% of %total%'|trans({'%position%': group.position, '%total%': group.total}) }}
                    </span>
                </span>
            </button>
            <ul class="dropdown-menu">
                {% if group.collection is not null %}
                    <li><h6 class="dropdown-header">{{ group.collection|trans }}</h6></li>
                {% endif %}
                {% for sibling in group.siblings %}
                    <li>
                        {% set naming %}
                            {% if sibling.number is not null %}
                                <span class="form-stepper-badge form-stepper-badge--muted">{{ sibling.number }}</span>
                            {% endif %}
                            <span class="flex-grow-1 text-truncate">{{ sibling.label }}</span>
                            {% if sibling.state is not null %}
                                <span class="text-body-secondary small">{{ sibling.state }}</span>
                            {% endif %}
                        {% endset %}
                        {{ self.goto(form, sibling.name, naming, {
                            'class': 'dropdown-item d-flex align-items-center gap-2' ~ (sibling.current ? ' active' : ''),
                        }) }}
                    </li>
                {% endfor %}
                <li><hr class="dropdown-divider"></li>
                <li>{{ self.goto(form, group.overview, (form.vars.step_labels[group.overview]|default(group.overview))|trans, {'class': 'dropdown-item text-gewis-primary'}) }}</li>
            </ul>
        </div>

        <ul class="nav nav-pills" role="tablist">
            {% for step in group.steps %}
                {% set marked %}
                    <span class="badge">{{ step.position }}</span>{{ step.label|trans }}
                {% endset %}
                <li class="nav-item" role="presentation">
                    {% if 'current' == step.state %}
                        <span class="nav-link active{{ step.done ? ' is-done' }}" role="tab"
                              aria-current="step">{{ marked }}</span>
                    {% else %}
                        {{ self.goto(form, step.name, marked, {
                            'class': 'nav-link' ~ (step.done ? ' is-done' : ''),
                            'role': 'tab',
                        }) }}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>

        <span class="ms-auto d-flex gap-2">
            {% if group.previous is not null %}
                {{ self.goto(form, group.previous, 'Previous'|trans, {'class': 'btn btn-sm btn-outline-secondary'}) }}
            {% endif %}
            {% if group.next is not null %}
                {{ self.goto(form, group.next, 'Next'|trans, {'class': 'btn btn-sm btn-outline-secondary'}) }}
            {% endif %}
        </span>
    </div>
{% endmacro %}

{% macro navigation(form, cancel_url = null, cancel_label = null) %}
    <div class="mt-3 d-flex justify-content-between gap-2">
        <span class="d-flex gap-2">
            {% if cancel_url is not null %}
                <a href="{{ cancel_url }}" class="btn btn-link">{{ cancel_label|default('Cancel'|trans) }}</a>
            {% endif %}
            {% if form_flow_can_move_back(form) and form.previous is defined %}
                {{ form_widget(form.previous, {'attr': {
                    'class': 'btn-outline-gewis-primary',
                    'formnovalidate': 'formnovalidate',
                }}) }}
            {% endif %}
        </span>
        <span class="ms-auto d-flex gap-2">
            {% if form.next is defined %}{{ form_widget(form.next) }}{% endif %}
            {% if form.finish is defined %}{{ form_widget(form.finish) }}{% endif %}
        </span>
    </div>
{% endmacro %}
