{#
    Every dropdown follows the same pattern: labelled groups of rows rather than one flat run of links, an icon per
    row, a count where knowing the number tells you whether the click is worth it, sub-sections that expand inside the
    panel instead of flying out sideways, and the action that ends the menu last behind a rule.
#}
{% macro item(href, icon, label, count, active) %}
    <li>
        <a href="{{ href }}" class="dropdown-item {{ active|default(false) ? 'active' : '' }}"
           {% if active|default(false) %}aria-current="page"{% endif %}>
            <span class="nav-menu-icon fas {{ icon }}" aria-hidden="true"></span>
            <span class="nav-menu-label">{{ label }}</span>
            {% if count|default(null) is not null %}
                <span class="nav-menu-count">{{ count }}</span>
            {% endif %}
        </a>
    </li>
{% endmacro %}

{% macro section(id, icon, label, children) %}
    <li>
        <button class="dropdown-item collapsed" type="button" data-bs-toggle="collapse"
                data-bs-target="#nav-menu-{{ id }}" aria-controls="nav-menu-{{ id }}" aria-expanded="false">
            <span class="nav-menu-icon fas {{ icon }}" aria-hidden="true"></span>
            <span class="nav-menu-label">{{ label }}</span>
            <span class="nav-menu-caret fas fa-chevron-down" aria-hidden="true"></span>
        </button>
        <ul class="nav-menu-sublist collapse" id="nav-menu-{{ id }}">
            {% for child in children %}
                <li>
                    <a href="{{ child.href }}" class="dropdown-item">
                        <span class="nav-menu-label">{{ child.label }}</span>
                        {% if child.count|default(null) is not null %}
                            <span class="nav-menu-count">{{ child.count }}</span>
                        {% endif %}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </li>
{% endmacro %}

