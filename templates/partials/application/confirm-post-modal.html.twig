{#
    A confirmation that posts, for anything irreversible; the browser's own dialog cannot carry the form the
    action needs.

    {% import 'partials/application/confirm-post-modal.html.twig' as modals %}

    {{ modals.confirm_modal(
        'modal-discard-draft',
        path('admin/career/approvals/company/discard', {'revision': revision.getId}),
        csrf_token('career_discard-' ~ revision.getId),
        'Discard draft?'|trans,
        'The changes in this draft will be lost and the live version restored.'|trans,
        'Discard draft'|trans,
        'gewis-primary',
    ) }}

    `body` and `label` may be more than a sentence: capture them with `{% set %}` first, which yields markup
    that is not escaped again. `fields` are extra hidden inputs the action needs beyond the token, as a map of
    name to value.
#}
{% macro confirm_modal(id, action, token, title, body, label, variant, fields = {}) %}
    <div class="modal fade" id="{{ id }}" tabindex="-1" aria-labelledby="{{ id }}-label" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="{{ id }}-label">{{ title }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                </div>
                <form method="post" action="{{ action }}">
                    <div class="modal-body">
                        <p class="mb-0">{{ body }}</p>
                    </div>
                    <div class="modal-footer">
                        <input type="hidden" name="_csrf_token" value="{{ token }}">
                        {% for name, value in fields %}
                            <input type="hidden" name="{{ name }}" value="{{ value }}">
                        {% endfor %}
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                        <button type="submit" class="btn btn-{{ variant }}">{{ label }}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endmacro %}
