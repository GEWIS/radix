{#
    The vacancy form, shared by the board's create/edit pages and the company's own. The slug and the job package are
    only offered while they may still be changed, and only the board decides whether a vacancy is shown at all, so
    the first step carries whichever of those apply.
#}
{% import 'partials/application/form-flow.html.twig' as flow %}

{% set step = form_flow_current_step(form) %}

{{ form_start(form, {'method': 'POST'}) }}
{{ form_errors(form) }}

{{ flow.stepper(form) }}

{% if 'general' == step %}
    {% set fields = form.general %}
    <div class="row">
        <div class="col-md-6">
            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'General'|trans }}</h3>
                </div>
                <div class="panel-body">
                    <div class="row">
                        {% if fields.slugName is defined %}
                            <div class="col-md-6">{{ form_row(fields.slugName) }}</div>
                            <div class="col-md-6">{{ form_row(fields.packageId) }}</div>
                        {% endif %}
                        <div class="col-md-4">{{ form_row(fields.category) }}</div>
                        <div class="col-md-4">{{ form_row(fields.startDate) }}</div>
                        <div class="col-md-4">{{ form_row(fields.endDate) }}</div>
                    </div>
                    {% if fields.published is defined %}
                        {{ form_row(fields.published) }}
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'Labels'|trans }}</h3>
                </div>
                <div class="panel-body">
                    {{ form_row(fields.labelIds) }}
                </div>
            </div>
        </div>
    </div>
{% elseif 'details' == step %}
    {% set fields = form.details %}
    <div class="row" data-controller="localised-fields">
        <div class="col-md-12">
            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'Details'|trans }}</h3>
                    <p class="text-muted small mb-0">
                        {{ 'Enable Dutch and/or English and fill in the fields below. At least one language must be used.'|trans }}
                    </p>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(fields.languageDutch, {
                                'label': '<span class="flag-icon flag-icon-nl"></span> ' ~ ('Dutch'|trans),
                                'label_html': true,
                                'attr': {
                                    'data-localised-fields-target': 'dutchToggle',
                                    'data-action': 'change->localised-fields#apply',
                                },
                            }) }}
                            <hr>
                            {{ form_row(fields.nameNL, {'attr': {'data-localised-fields-target': 'dutch'}}) }}
                            {{ form_row(fields.locationNL, {'attr': {'data-localised-fields-target': 'dutch'}}) }}
                            {{ form_row(fields.websiteNL, {'attr': {'data-localised-fields-target': 'dutch'}}) }}
                            {{ form_row(fields.attachmentNL, {'attr': {'data-localised-fields-target': 'dutch'}}) }}
                            {{ form_row(fields.descriptionNL, {'attr': {'data-localised-fields-target': 'dutch', 'data-controller': 'markdown-editor', 'data-markdown-editor-language-value': app.request.locale}}) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(fields.languageEnglish, {
                                'label': '<span class="flag-icon flag-icon-en"></span> ' ~ ('English'|trans),
                                'label_html': true,
                                'attr': {
                                    'data-localised-fields-target': 'englishToggle',
                                    'data-action': 'change->localised-fields#apply',
                                },
                            }) }}
                            <hr>
                            {{ form_row(fields.nameEN, {'attr': {'data-localised-fields-target': 'english'}}) }}
                            {{ form_row(fields.locationEN, {'attr': {'data-localised-fields-target': 'english'}}) }}
                            {{ form_row(fields.websiteEN, {'attr': {'data-localised-fields-target': 'english'}}) }}
                            {{ form_row(fields.attachmentEN, {'attr': {'data-localised-fields-target': 'english'}}) }}
                            {{ form_row(fields.descriptionEN, {'attr': {'data-localised-fields-target': 'english', 'data-controller': 'markdown-editor', 'data-markdown-editor-language-value': app.request.locale}}) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% else %}
    {% set fields = form.contact %}
    <div class="row">
        <div class="col-md-12">
            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'Contact details'|trans }}</h3>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-4">{{ form_row(fields.contactName) }}</div>
                        <div class="col-md-4">{{ form_row(fields.contactEmail) }}</div>
                        <div class="col-md-4">{{ form_row(fields.contactPhone) }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endif %}

{{ flow.navigation(form, cancelUrl) }}
{{ form_end(form) }}
