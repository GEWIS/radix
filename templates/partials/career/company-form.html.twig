{% import 'partials/application/form-flow.html.twig' as flow %}

{% set step = form_flow_current_step(form) %}

{{ form_start(form, {'method': 'POST'}) }}
{{ form_errors(form) }}

{{ flow.stepper(form) }}

{% if 'identity' == step %}
    {% set fields = form.identity %}
    <div class="row">
        <div class="col-md-6">
            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'Identity'|trans }}</h3>
                </div>
                <div class="panel-body">
                    {{ form_row(fields.name) }}
                    {{ form_row(fields.slugName) }}
                    {{ form_row(fields.published) }}
                </div>
            </div>
        </div>
    </div>
{% elseif 'profile' == step %}
    {% set fields = form.profile %}
    <div class="row" data-controller="localised-fields">
        <div class="col-md-12">
            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'Profile'|trans }}</h3>
                    <p class="text-muted small mb-0">
                        {{ 'Enable Dutch and/or English and fill in the fields below. At least one language must be used.'|trans }}
                    </p>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(fields.languageDutch, {
                                'label': '<span class="flag-icon flag-icon-nl"></span> ' ~ ('Dutch'|trans),
                                'label_html': true,
                                'attr': {
                                    'data-localised-fields-target': 'dutchToggle',
                                    'data-action': 'change->localised-fields#apply',
                                },
                            }) }}
                            <hr>
                            {{ form_row(fields.sloganNL, {'attr': {'data-localised-fields-target': 'dutch'}}) }}
                            {{ form_row(fields.websiteNL, {'attr': {'data-localised-fields-target': 'dutch'}}) }}
                            {{ form_row(fields.descriptionNL, {'attr': {'data-localised-fields-target': 'dutch', 'data-controller': 'markdown-editor', 'data-markdown-editor-language-value': app.request.locale}}) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(fields.languageEnglish, {
                                'label': '<span class="flag-icon flag-icon-en"></span> ' ~ ('English'|trans),
                                'label_html': true,
                                'attr': {
                                    'data-localised-fields-target': 'englishToggle',
                                    'data-action': 'change->localised-fields#apply',
                                },
                            }) }}
                            <hr>
                            {{ form_row(fields.sloganEN, {'attr': {'data-localised-fields-target': 'english'}}) }}
                            {{ form_row(fields.websiteEN, {'attr': {'data-localised-fields-target': 'english'}}) }}
                            {{ form_row(fields.descriptionEN, {'attr': {'data-localised-fields-target': 'english', 'data-controller': 'markdown-editor', 'data-markdown-editor-language-value': app.request.locale}}) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% elseif 'contact' == step %}
    {% set fields = form.contact %}
    <div class="row">
        <div class="col-md-12">
            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'Contact details'|trans }}</h3>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-6">{{ form_row(fields.contactName) }}</div>
                        <div class="col-md-6">{{ form_row(fields.contactEmail) }}</div>
                        <div class="col-md-6">{{ form_row(fields.contactPhone) }}</div>
                        <div class="col-md-6">{{ form_row(fields.contactAddress) }}</div>
                    </div>
                </div>
            </div>

            {% include 'partials/application/social-links-form.html.twig' with {
                'field': fields.socialLinks,
            } only %}
        </div>
    </div>
{% else %}
    {% set fields = form.logo %}
    <div class="row">
        <div class="col-md-6">
            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'Logo'|trans }}</h3>
                </div>
                <div class="panel-body">
                    {% if revision is not null and revision.squareLogo is not null %}
                        <img class="career-logo career-logo-lg mb-3"
                             src="{{ image_url(revision.squareLogo, 'w320') }}" alt="">
                    {% endif %}
                    {{ form_row(fields.squareLogoFile) }}
                    {% if revision is not null and revision.bannerLogo is not null %}
                        <img class="career-logo career-logo-plate mb-3"
                             src="{{ image_url(revision.bannerLogo, 'w640') }}" alt="">
                    {% endif %}
                    {{ form_row(fields.bannerLogoFile) }}
                </div>
            </div>
        </div>
    </div>
{% endif %}

{{ flow.navigation(form, cancelUrl) }}
{{ form_end(form) }}
