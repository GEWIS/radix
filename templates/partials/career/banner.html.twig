{#
    The renditions behind a banner are generated at exactly the box its format is shown in, and the element is
    given those dimensions so nothing on the page moves while it loads.
#}
<img class="banner-image {{ class|default('') }}"
     loading="lazy"
     alt="{{ alt|default('') }}"
     width="{{ format.width }}"
     height="{{ format.height }}"
     src="{{ image_url(path, format.variant) }}"
     srcset="{{ image_url(path, format.variant) }} 1x, {{ image_url(path, format.retinaVariant) }} 2x">
