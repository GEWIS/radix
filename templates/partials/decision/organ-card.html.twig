{#
    {% include 'partials/decision/organ-card.html.twig' with {'organ': organ} only %}

    Pass `dated` to link with the body's foundation year, which is what tells two bodies apart when an
    abbreviation has been reused. The historical overviews always do; the current ones do not.
#}
{% set information = organ.organInformation %}
{# A dated link carries the whole founding date: two bodies founded in the same year share a year but never a date,
   and a card knows nothing about its namesakes to tell which case it is in. #}
{% set url = path('association/body', {
    'type': organ.type.value,
    'abbr': organ.abbr,
    'founded': dated|default(false) ? organ.foundationDate|date('Y-m-d') : null,
}) %}
<div class="col">
    <div class="card organ-card h-100">
        <a class="card-img-top text-decoration-none" href="{{ url }}">
            {% include 'partials/application/image-or-monogram.html.twig' with {
                'path': information ? information.logoPath : null,
                'name': organ.abbr,
                'variant': 'w320',
                'baseClass': 'organ-logo',
                'alt': organ.name,
            } only %}
        </a>
        <div class="card-body">
            <h5 class="card-title mb-1"><a href="{{ url }}">{{ organ.abbr }}</a></h5>
            <h6 class="card-subtitle text-muted fw-normal mb-2">{{ organ.name }}</h6>
            {% if information and information.shortDescription %}
                <p class="card-text small">{{ information.shortDescription|localise_text }}</p>
            {% endif %}
        </div>
        {% if information %}
            <div class="card-footer text-body-secondary icon-links flex-wrap">
                {% if is_granted('ROLE_USER') and information.email is not null %}
                    <a href="mailto:{{ information.email }}" title="{{ 'Email address'|trans }}">
                        <span class="fas fa-envelope" aria-hidden="true"></span>
                        <span class="visually-hidden">{{ 'Email address'|trans }}</span>
                    </a>
                {% endif %}
                {% if information.website is not null %}
                    <a href="{{ information.website }}" target="_blank" rel="noopener noreferrer"
                       title="{{ 'Website'|trans }}">
                        <span class="fas fa-globe" aria-hidden="true"></span>
                        <span class="visually-hidden">{{ 'Website'|trans }}</span>
                    </a>
                {% endif %}
                {% include 'partials/application/social-links.html.twig' with {
                    'links': information.getSocialLinks,
                    'inline': true,
                } only %}
            </div>
        {% endif %}
    </div>
</div>
