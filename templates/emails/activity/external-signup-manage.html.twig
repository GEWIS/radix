{% extends 'emails/_base.html.twig' %}
{% import 'emails/_partials/blocks.html.twig' as blocks %}

{% block emailTitle %}Manage your sign-up{% endblock %}
{% block preheader %}Manage&nbsp;your&nbsp;sign-up{% endblock %}
{% block heading %}{{ activityName }}{% endblock %}
{% block subheading %}Manage your sign-up{% endblock %}
{% block body %}
    <p>Dear {{ name }},</p>
    <p>Your details have been successfully added to the sign-up list for <em>{{ activityName }}</em> ({{ signupListName }}). As long as the list remains open, you can review your details or remove your name.</p>
    {{ blocks.button(url, 'Manage your sign-up') }}
    {{ blocks.fallback(url) }}
    <p>Please keep this email safe, as this link is the only way to access and manage your sign-up.</p>
    <p>With kind regards,<br/>The ApplicatieBeheerCommissie</p>
{% endblock %}
