{% extends 'emails/_base.html.twig' %}

{% block emailTitle %}A photographer is needed{% endblock %}
{% block preheader %}An&nbsp;activity&nbsp;has&nbsp;asked&nbsp;for&nbsp;GEFLITST{% endblock %}
{% block heading %}A photographer is needed{% endblock %}
{% block subheading %}{{ nameEN ?? nameNL }}{% endblock %}
{% block body %}
    <p>L.s.,</p>
    <p>Er is een activiteit in de maak op de GEWIS-website waarvoor een fotograaf van GEFLITST nodig is.</p>
    <h3>{{ nameNL }}</h3>
    <p>{{ descriptionNL }}</p>
    <hr>
    <p>An activity is being planned on the GEWIS website that needs a photographer from GEFLITST.</p>
    <h3>{{ nameEN }}</h3>
    <p>{{ descriptionEN }}</p>
    <p><strong>{{ requester }}</strong> would like to hear back from you. You can answer by replying to this email.</p>
    With kind regards,<br> The ApplicatieBeheerCommissie
{% endblock %}
{% block footerNote %}You receive this email because an activity asked for a photographer.{% endblock %}
