{% extends 'emails/_base.html.twig' %}
{% import 'emails/_partials/blocks.html.twig' as blocks %}

{% block emailTitle %}Confirm your sign-up{% endblock %}
{% block preheader %}Confirm&nbsp;your&nbsp;sign-up{% endblock %}
{% block heading %}{{ activityName }}{% endblock %}
{% block subheading %}Confirm your sign-up{% endblock %}
{% block body %}
    <p>Dear {{ name }},</p>
    <p>To complete your sign-up for <em>{{ activityName }}</em> ({{ signupListName }}), please confirm your email address within 24 hours.</p>
    {{ blocks.button(url, 'Confirm your sign-up') }}
    {{ blocks.fallback(url) }}
    <p>If you do not confirm within 24 hours, your details will not be saved. If you did not sign up for this activity, you can safely ignore this email.</p>
    <p>With kind regards,<br/>The ApplicatieBeheerCommissie</p>
{% endblock %}
