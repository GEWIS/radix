{% extends 'emails/_base.html.twig' %}
{% import 'emails/_partials/blocks.html.twig' as blocks %}

{% block emailTitle %}{{ headline }}{% endblock %}
{% block preheader %}{{ headline|replace({' ': '&nbsp;'})|raw }}{% endblock %}
{% block heading %}Account security{% endblock %}
{% block subheading %}{{ headline }}{% endblock %}
{% block body %}
    <p>Dear {{ fullName }},</p>
    <p>{{ summary }}</p>
    {{ blocks.facts(details) }}
    <p>If the details above look familiar, there is nothing to do and you can ignore this email.</p>
    <p>If they do not, somebody else may have access to your account. Change your password as soon as you can, which also signs out every device that is signed in right now.</p>
    {{ blocks.button(resetUrl, 'Change your password') }}
    {{ blocks.fallback(resetUrl) }}
    <p>If a new password does not get you back into your account, write to <a href="mailto:gewisweb@gewis.nl" style="color: #C40000; text-decoration: none;">gewisweb@gewis.nl</a>.</p>
    <p>With kind regards,<br/>The ApplicatieBeheerCommissie</p>
{% endblock %}
{% block footerNote %}You receive this email because it is a security notice about your account. It cannot be turned off.{% endblock %}
