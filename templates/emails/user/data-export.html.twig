{% extends 'emails/_base.html.twig' %}
{% import 'emails/_partials/blocks.html.twig' as blocks %}

{% block emailTitle %}Your data export{% endblock %}
{% block preheader %}Your&nbsp;data&nbsp;export&nbsp;is&nbsp;ready{% endblock %}
{% block heading %}Account security{% endblock %}
{% block subheading %}Your data export is ready{% endblock %}
{% block body %}
    <p>Dear {{ fullName }},</p>
    <p>You asked for an export of the data the GEWIS website holds about you, and it is ready to download.</p>
    {{ blocks.button(downloadUrl, 'Download your data') }}
    {{ blocks.fallback(downloadUrl) }}
    <p>You need to be signed in to your GEWIS account to download the file. The export is removed after three days, after which you can ask for a fresh one. If you did not ask for this export, you can safely ignore this email.</p>
    <p>This export covers the GEWIS website only. For any other personal data GEWIS holds, please contact the privacy officers.</p>
    <p>With kind regards,<br/>The ApplicatieBeheerCommissie</p>
{% endblock %}
{% block footerNoteSection %}{% endblock %}
