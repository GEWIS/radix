{% extends 'emails/_base.html.twig' %}
{% import 'emails/_partials/blocks.html.twig' as blocks %}

{% block emailTitle %}Request to reset password{% endblock %}
{% block preheader %}Request&nbsp;to&nbsp;reset&nbsp;password{% endblock %}
{% block heading %}Account security{% endblock %}
{% block subheading %}Reset your password{% endblock %}
{% block body %}
    <p>Dear {{ fullName }},</p>
    <p>We received a request to reset the password of your GEWIS account. Choose a new one with the button below.</p>
    {{ blocks.button(resetUrl, 'Reset your password') }}
    {{ blocks.fallback(resetUrl) }}
    <p>The link stops working 15 minutes after this email was sent. If you asked for a reset more than once, only the link in this email still works.</p>
    <p>If you did not ask for this, your account is safe: nothing has changed and you can keep signing in with your current password. You can ignore this email.</p>
    <p>With kind regards,<br/>The ApplicatieBeheerCommissie</p>
{% endblock %}
{% block footerNoteSection %}{% endblock %}
