{% extends 'emails/_base.html.twig' %}
{% import 'emails/_partials/blocks.html.twig' as blocks %}

{% block emailTitle %}A decision on your submission{% endblock %}
{% block preheader %}A&nbsp;decision&nbsp;on&nbsp;your&nbsp;submission{% endblock %}
{% block heading %}{{ subjectName }}{% endblock %}
{% block subheading %}Your contact at GEWIS has looked at what you submitted{% endblock %}
{% block body %}
    <p>Dear {{ fullName }},</p>
    {% if outcome == 'approved' %}
        <p>{% if isVacancy %}The vacancy{% else %}The profile{% endif %} you submitted for {{ companyName }} has been approved and is now on the GEWIS website.</p>
    {% else %}
        {% if outcome == 'changes-requested' %}
            <p>Your contact at GEWIS has asked for changes to {% if isVacancy %}the vacancy{% else %}the profile{% endif %} you submitted for {{ companyName }}. What is currently on the website is unchanged in the meantime.</p>
            <p>Their feedback is on the career portal, along with the version you submitted.</p>
        {% else %}
            <p>Your contact at GEWIS has not approved {% if isVacancy %}the vacancy{% else %}the profile{% endif %} you submitted for {{ companyName }}. What is currently on the website is unchanged.</p>
            <p>You can read why on the career portal.</p>
        {% endif %}
        {{ blocks.button(portalUrl, 'Open the career portal') }}
        {{ blocks.fallback(portalUrl) }}
    {% endif %}
    <p>With kind regards,<br/>The External Affairs Officer</p>
{% endblock %}
{% block footerNoteSection %}{% endblock %}
