{% extends 'emails/_base.html.twig' %}
{% import 'emails/_partials/blocks.html.twig' as blocks %}

{% block emailTitle %}Invitation to the GEWIS career portal{% endblock %}
{% block preheader %}Invitation&nbsp;to&nbsp;the&nbsp;GEWIS&nbsp;career&nbsp;portal{% endblock %}
{% block heading %}Represent {{ companyName }}{% endblock %}
{% block subheading %}Set a password to start using the GEWIS career portal{% endblock %}
{% block body %}
    <p>Dear {{ fullName }},</p>
    <p>You have been invited to represent {{ companyName }} on the GEWIS website. Through the career portal you can keep the company profile up to date, post vacancies, and follow what your contact at GEWIS makes of them.</p>
    {{ blocks.button(inviteUrl, 'Choose a password') }}
    {{ blocks.fallback(inviteUrl) }}
    <p>The link stops working after {{ expiresAt|date('j F Y') }}.</p>
    <p>If you were not expecting this invitation, you can ignore this email. Without the link above no account is created.</p>
    <p>With kind regards,<br/>The External Affairs Officer</p>
{% endblock %}
{% block footerNoteSection %}{% endblock %}
