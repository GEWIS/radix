{# Shared pieces for the transactional emails. Everything is a table with inline styles, because that is the only
   layout a mail client can be relied on to render. #}

{# A block of labelled facts about what happened, as rows of `label` and `value`. Kept out of the sentence above it so
   the reader can check a date or an address at a glance instead of reading it back out of prose. #}
{% macro facts(rows) %}
    <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="mso-table-lspace: 0pt; mso-table-rspace: 0pt; background-color: #FFFFFF; border-left: 4px solid #C40000;" width="100%">
        <tbody>
        <tr>
            <td style="padding: 16px 20px;">
                <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="mso-table-lspace: 0pt; mso-table-rspace: 0pt;" width="100%">
                    <tbody>
                    {% for row in rows %}
                        <tr>
                            <th align="left" scope="row" style="padding: 4px 12px 4px 0; font-family: Roboto, Tahoma, Verdana, Segoe, sans-serif; font-size: 15px; font-weight: 700; color: #333333; text-align: left; vertical-align: top;" width="40%">{{ row.label }}</th>
                            <td style="padding: 4px 0; font-family: Roboto, Tahoma, Verdana, Segoe, sans-serif; font-size: 15px; color: #333333; vertical-align: top; word-break: break-word;" width="60%">{{ row.value }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </td>
        </tr>
        </tbody>
    </table>
{% endmacro %}

{# The one thing the email asks the reader to do. Centred by an outer full-width table rather than by CSS: a button
   table has to shrink to fit its label, and `align="center"` on a cell is the only way every client agrees to centre
   one. Outlook drops the rounded corners and renders a square button, which is the whole of what it loses. #}
{% macro button(url, label) %}
    <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="mso-table-lspace: 0pt; mso-table-rspace: 0pt;" width="100%">
        <tbody>
        <tr>
            <td align="center" style="padding: 8px 0;">
                <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="mso-table-lspace: 0pt; mso-table-rspace: 0pt; margin: 0 auto;">
                    <tbody>
                    <tr>
                        <td align="center" bgcolor="#C40000" style="border-radius: 4px;">
                            <a href="{{ url }}" style="display: inline-block; padding: 13px 28px; font-family: Roboto, Tahoma, Verdana, Segoe, sans-serif; font-size: 16px; font-weight: 700; color: #FFFFFF; text-decoration: none; border-radius: 4px;" target="_blank" rel="noopener nofollow">{{ label }}</a>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </td>
        </tr>
        </tbody>
    </table>
{% endmacro %}

{# The same link again as text, for whoever cannot press the button: a client that strips the styling, a printed copy,
   or a reader who wants to see where it goes before following it. #}
{% macro fallback(url) %}
    <p style="font-size: 14px; color: #555555;">If the button does not work, copy this link into your browser:<br/><a href="{{ url }}" style="color: #C40000; text-decoration: none; word-break: break-all;" target="_blank" rel="noopener nofollow">{{ url }}</a></p>
{% endmacro %}
