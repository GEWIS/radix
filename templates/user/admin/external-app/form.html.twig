{% extends 'layout-admin.html.twig' %}

{% import 'partials/application/form-flow.html.twig' as flow %}

{% set is_edit = externalApp is not null %}

{% block page_title %}
    {{ (is_edit ? 'Edit external application'|trans : 'Create external application'|trans)|page_title }}{{ 'Users'|trans|page_title }}{{ parent() }}
{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item active" aria-current="page">
        <a href="{{ path('admin/users/apps/index') }}">{{ 'External applications'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">
        {{ is_edit ? 'Edit external application'|trans : 'Create external application'|trans }}
    </li>
{% endblock %}

{% block contents %}
    {% set step = form_flow_current_step(form) %}
    <div class="row justify-content-center">
        <div class="col col-lg-9 col-xl-8">
            {{ form_start(form) }}
            {{ form_errors(form) }}

            {{ flow.stepper(form) }}

            {% if 'application' == step %}
                <div class="panel">
                    <div class="panel-heading">
                        <h3>{{ 'Application'|trans }}</h3>
                    </div>
                    <div class="panel-body">
                        {{ form_row(form.application.appId) }}
                        {{ form_row(form.application.callback) }}
                        {{ form_row(form.application.url) }}
                    </div>
                </div>
            {% elseif 'signing' == step %}
                <div class="panel" data-controller="external-app-signing">
                    <div class="panel-heading">
                        <h3>{{ 'Signing and delivery'|trans }}</h3>
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form.signing.signature, {'attr': {
                                    'data-external-app-signing-target': 'signature',
                                    'data-action': 'change->external-app-signing#apply',
                                }}) }}
                            </div>
                            <div class="col-md-6">{{ form_row(form.signing.tokenDelivery) }}</div>
                        </div>
                        <div class="alert alert-warning d-none" role="alert"
                             data-external-app-signing-target="warning">
                            <strong>{{ 'Avoid RS512 for new applications.'|trans }}</strong>
                            {{ 'It signs with PKCS#1 v1.5, kept only for applications that cannot verify anything stronger. Prefer EdDSA, ES512, or PS512 whenever the application supports them.'|trans }}
                        </div>
                        <div data-external-app-signing-target="secretField">
                            {{ form_row(form.signing.secret, {'attr': {'data-external-app-signing-target': 'secret'}}) }}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="panel">
                    <div class="panel-heading">
                        <h3>{{ 'Claims and availability'|trans }}</h3>
                    </div>
                    <div class="panel-body">
                        {{ form_label(form.claims.claims) }}
                        {% if form.claims.claims.vars.help is not empty %}
                            <p class="form-text text-muted">{{ form.claims.claims.vars.help|trans }}</p>
                        {% endif %}
                        {{ form_widget(form.claims.claims) }}
                        {{ form_errors(form.claims.claims) }}
                        <hr>
                        <div class="row">
                            <div class="col-md-6">{{ form_row(form.claims.enabled) }}</div>
                            <div class="col-md-6">{{ form_row(form.claims.expiresAt) }}</div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {{ flow.navigation(form, path('admin/users/apps/index')) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
