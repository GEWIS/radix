{% import 'database/partials/member/labels.html.twig' as labels %}
{% import 'partials/application/confirm-post-modal.html.twig' as modals %}

<div class="mb-4">
    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
        <h3 class="h5 mb-0">{{ labels.address_type(address.type) }}</h3>
        {% if is_granted('ROLE_DATABASE_ADMIN') %}
            <a href="{{ path('member_address_edit', {lidnr: member.lidnr, type: address.type.value}) }}"
               class="btn btn-sm btn-gewis-primary">
                {{ 'Change'|trans }}
            </a>
            <button type="button" class="btn btn-sm btn-outline-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#modal-remove-address-{{ member.lidnr }}-{{ address.type.value }}">
                {{ 'Delete'|trans }}
            </button>
        {% endif %}
    </div>
    <table class="table table-bordered mb-0">
        <tbody>
            <tr>
                <th scope="row">{{ 'Postal Region'|trans }}</th>
                <td>{{ address.country.value }}</td>
            </tr>
            <tr>
                <th scope="row">{{ 'Street and House Number'|trans }}</th>
                <td>{{ address.street }} {{ address.number }}</td>
            </tr>
            <tr>
                <th scope="row">{{ 'City and Postal Code'|trans }}</th>
                <td>{{ address.city }} {{ address.postalCode }}</td>
            </tr>
            <tr>
                <th scope="row">{{ 'Phone Number'|trans }}</th>
                <td>{{ address.phone }}</td>
            </tr>
        </tbody>
    </table>
</div>

{{ modals.confirm_modal(
    'modal-remove-address-' ~ member.lidnr ~ '-' ~ address.type.value,
    path('member_address_remove', {lidnr: member.lidnr, type: address.type.value}),
    csrf_token('member_address_remove-' ~ member.lidnr),
    'Delete Address'|trans,
    'This deletes the %type% of %name%.'|trans({
        '%type%': labels.address_type(address.type),
        '%name%': member.fullName,
    }),
    'Delete'|trans,
    'outline-danger',
) }}
