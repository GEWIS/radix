{# The embedding page fills in `registration_intro`, and a page that invites someone to join fills
   `registration_details` as well.

   `header_title` has no fallback on purpose: a default would be inherited by the renewal and checkout pages,
   which are not about becoming a member. #}
<div class="panel">
    <div class="panel-body p-4 p-md-5">
        <div class="registration-intro">
            <h1 class="registration-title mb-3">{{ header_title }}</h1>
            {% block registration_intro %}{% endblock %}
        </div>

        {% block registration_details %}{% endblock %}

        <p class="registration-intro mt-4 mb-0">
            {{ 'If you have any questions feel free to contact'|trans }}
            <a href="mailto:board@gewis.nl">board@gewis.nl</a>.
        </p>
    </div>
</div>
