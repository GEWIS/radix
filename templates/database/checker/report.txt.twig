{# `reports` holds one entry per checked meeting -- `{'meeting': ..., 'errors': [...]}`.

   The heading names the meeting type as well as the number because numbering restarts per type. A `.txt.twig`
   template is not escaped, so every line arrives as `App\ViewModel\Checker\Error::asText()` wrote it. #}
{% for report in reports %}
Errors after {{ report.meeting.type.value }} {{ report.meeting.number }} held at {{ report.meeting.date|date('Y-m-d') }}
{% for error in report.errors %}
{{ error.asText }}
{% endfor %}

{% endfor %}
