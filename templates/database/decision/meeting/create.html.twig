{% extends 'layout-register.html.twig' %}

{% block page_title %}{{ 'Add Meeting'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item"><a href="{{ path('admin/meetings/index') }}">{{ 'Meetings'|trans }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Add Meeting'|trans }}</li>
{% endblock %}

{% block page_header %}
    {% embed 'partials/application/page-header.html.twig' %}
        {% block header_container_class %}container-fluid px-3{% endblock %}
        {% block header_title %}{{ 'Add Meeting'|trans }}{% endblock %}
        {% block header_subtitle %}
            <p class="page-header-meta mb-0">
                {{ 'The type and the number together address the meeting and everything decided at it.'|trans }}
            </p>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block contents %}
    {% set suggestion_island = {} %}
    {% for suggestion in suggestions %}
        {% set suggestion_island = suggestion_island|merge({
            (suggestion.type.value): {
                name: suggestion.type|trans,
                next: suggestion.next,
                latest: suggestion.latestNumber,
                date: suggestion.latestDate is null ? null : suggestion.latestDate|format_date('long'),
                isoDate: suggestion.datesFollowNumbers and suggestion.latestDate is not null ? suggestion.latestDate|date('Y-m-d') : null,
                missing: suggestion.missingNumbers,
            },
        }) %}
    {% endfor %}

    <div class="row g-3">
        <div class="col-12 col-xl-6">
            <div class="panel">
                <div class="panel-body">
                    {{ form_start(form, {attr: {
                        'data-controller': 'meeting-number',
                        'data-meeting-number-suggestions-value': suggestion_island|json_encode,
                        'data-meeting-number-latest-message-value': 'The last %type% on record is %type% %number%, held on %date%.'|trans,
                        'data-meeting-number-none-message-value': 'No %type% has been recorded yet.'|trans,
                        'data-meeting-number-missing-message-value': 'Not recorded yet:'|trans,
                        'data-meeting-number-use-label-value': 'Use %number%'|trans,
                        'data-meeting-number-date-warning-message-value': '%type% %number% was held on %date%, which is after the date entered.'|trans,
                    }}) }}
                        {{ form_row(form.type, {attr: {
                            'data-meeting-number-target': 'type',
                            'data-action': 'meeting-number#suggest',
                        }}) }}
                        {{ form_row(form.number, {
                            attr: {
                                'data-meeting-number-target': 'number',
                                'data-action': 'meeting-number#checkDate',
                            },
                            help: 'Filled in from the last meeting of the type on record.'|trans,
                            help_attr: {'data-meeting-number-target': 'hint'},
                        }) }}
                        {{ form_row(form.date, {attr: {
                            'data-meeting-number-target': 'date',
                            'data-action': 'meeting-number#checkDate',
                        }}) }}
                        <div class="form-text text-warning mb-2" data-meeting-number-target="dateWarning" hidden></div>
                        {{ form_widget(form.submit, {'attr': {'class': 'btn-gewis-primary'}}) }}
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
