{% extends 'layout.html.twig' %}


{% block page_title %}{{ 'Graduate renewal'|trans|page_title }}{{ parent() }}{% endblock %}

{% block contents %}
    {% embed 'database/partials/join/registration-header.html.twig' with {header_title: 'Graduate renewal'|trans} %}
        {% block registration_intro %}
            <p>
                {{ 'Thank you %name%! Your graduate status has been renewed and we have sent you a confirmation by e-mail.'|trans({
                    '%name%': member.firstName,
                }) }}
            </p>
        {% endblock %}
    {% endembed %}
{% endblock %}
