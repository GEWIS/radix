{% extends 'layout.html.twig' %}

{% import 'partials/application/form-flow.html.twig' as flow %}

{% block page_title %}{{ 'GEWIS Registration'|trans|page_title }}{{ parent() }}{% endblock %}

{#
    Five steps, a request each. Nothing is stored before the last one is accepted; what has been entered so far lives
    in the session, which is what going back to an earlier step reads from.
#}
{% macro review_row(label, value, step, form) %}
    <div class="registration-review-row">
        <dt>{{ label }}</dt>
        <dd>{% if value is empty %}<span class="registration-review-empty">{{ 'Not filled in'|trans }}</span>{% else %}{{ value }}{% endif %}</dd>
        <button type="submit" class="btn btn-sm btn-link registration-review-edit" formnovalidate
                name="{{ form.previous.vars.full_name }}" value="{{ step }}">
            {{ 'Edit'|trans }}<span class="visually-hidden"> {{ label }}</span>
        </button>
    </div>
{% endmacro %}

{% block contents %}
    {% import _self as review %}
    {% set data = form.vars.data %}
    {% set step = form_flow_current_step(form) %}

    {% embed 'database/partials/join/registration-header.html.twig' with {header_title: 'Become a member of GEWIS'|trans} %}
        {% block registration_intro %}
            <p>
                {{ 'Welcome! With this form you can register for a membership of GEWIS. Becoming a member of the assocation costs a one-time fee of 20 euros and your membership is valid as long as you study.'|trans }}
            </p>
        {% endblock %}

        {% block registration_details %}
            {% include 'database/partials/join/membership-benefits.html.twig' only %}
        {% endblock %}
    {% endembed %}

    {# Creating the Stripe session is slow. A second submit finishes first and has no checkout URL to redirect to,
       so the button is disabled as soon as the form is submitted. #}
    {{ form_start(form, {attr: {
        'id': 'form-subscribe',
        'data-controller': 'submit-once',
        'data-action': 'submit->submit-once#lock',
        'data-submit-once-label-value': 'Processing...'|trans,
    }}) }}

    {{ form_errors(form) }}
    {{ flow.stepper(form) }}

    {% if 'personal' == step %}
        {% set fields = form.personal %}
        <div class="panel">
            <div class="panel-heading"><h3>{{ 'Personal details'|trans }}</h3></div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-2">
                        {{ form_row(fields.initials, {attr: {
                            'data-controller': 'initials',
                            'data-action': 'focusout->initials#normalise',
                        }}) }}
                    </div>
                    <div class="col-md-4">{{ form_row(fields.firstName) }}</div>
                    <div class="col-md-2">{{ form_row(fields.middleName) }}</div>
                    <div class="col-md-4">{{ form_row(fields.lastName) }}</div>
                </div>
                <div class="row">
                    <div class="col-md-8">
                        {{ form_row(fields.email, {help: 'We use this address for everything we send you, so use one you keep after you stop studying.'|trans}) }}
                    </div>
                    <div class="col-md-4">{{ form_row(fields.birth) }}</div>
                </div>
            </div>
        </div>
    {% elseif 'study' == step %}
        {% set fields = form.study %}
        <div class="panel">
            <div class="panel-heading"><h3>{{ 'Study'|trans }}</h3></div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-6">
                        {# `t()`, not a bare string: the extractor cannot see one and `--clean` deletes it. #}
                        {{ form_row(fields.studentNumber, {
                            help_html: true,
                            help: t('Your student number is a 7-digit number, for example 1234560. You have received this in an email when you enrolled and it is printed on your campus card. Go to <a href="%url%">this page</a> if you need help finding it. Your student number will be used to verify you are studying at the department of M&CS.', {'%url%': 'https://wiki.gewis.nl/link/495'}),
                        }) }}
                    </div>
                    <div class="col-md-6" data-controller="study-notice">
                        {{ form_row(fields.study, {attr: {'data-action': 'change->study-notice#toggle'}}) }}
                        {# The footnote marker is put on the label by `StudyChoices`, so the notice keys off the
                           option text rather than off a list of studies repeated here. It starts out visible, as
                           it does for an empty selection. #}
                        <p class="form-text" data-study-notice-target="notice">
                            {{ '¹ DSA Pattern is the study association for students of the data science programs. The introduction week, round table discussions, and other education activities for these programs are organized by Pattern. Although you can join GEWIS, you might benefit more from joining Pattern on <a href="https://dsapattern.nl/" target="_blank">their website</a>.'|trans|raw }}
                        </p>
                    </div>
                </div>
            </div>
        </div>
    {% elseif 'address' == step %}
        {% set fields = form.address %}
        <div class="panel">
            <div class="panel-heading"><h3>{{ 'Address'|trans }}</h3></div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-8">{{ form_row(fields.street) }}</div>
                    <div class="col-md-4">{{ form_row(fields.number) }}</div>
                </div>
                <div class="row">
                    <div class="col-md-4">{{ form_row(fields.postalCode) }}</div>
                    <div class="col-md-8">{{ form_row(fields.city) }}</div>
                </div>
                {{ form_row(fields.country) }}
                {{ form_row(fields.phone) }}
            </div>
        </div>
    {% elseif 'lists' == step %}
        <div class="panel">
            <div class="panel-heading"><h3>{{ 'Mailing lists'|trans }}</h3></div>
            <div class="panel-body">
                <p>
                    {{ 'As a GEWIS member, you are automatically subscribed to the "announcements" mailing list. This list is used solely for announcements from the study association, such as invitations to General Members Meetings (GMMs). In addition, there are several other optional mailing lists. You can subscribe to the following mailing lists. These subscriptions can be changed at a later date.'|trans }}
                </p>
                {{ form_row(form.lists.lists) }}
                <p class="form-text mb-0">
                    {{ 'You can change these at any time once you are a member.'|trans }}
                </p>
            </div>
        </div>
    {% else %}
        <div class="panel">
            <div class="panel-heading"><h3>{{ 'Review'|trans }}</h3></div>
            <div class="panel-body">
                <dl class="registration-review mb-0">
                    {{ review.review_row('Name'|trans, data.fullName, 'personal', form) }}
                    {{ review.review_row('E-mail Address'|trans, data.email, 'personal', form) }}
                    {{ review.review_row('Birthdate'|trans, data.birth ? data.birth|date('Y-m-d') : null, 'personal', form) }}
                    {{ review.review_row('TU/e student number'|trans, data.studentNumber, 'study', form) }}
                    {{ review.review_row('Study'|trans, data.study ? data.study.value|trans : null, 'study', form) }}
                    {{ review.review_row('Address'|trans, [
                        data.street ~ ' ' ~ data.number, data.postalCode, data.city,
                        data.country ? data.country.value|lower|title : null,
                    ]|filter(part => part is not empty)|join(', '), 'address', form) }}
                    {{ review.review_row('Phone Number'|trans, data.phone, 'address', form) }}
                    {{ review.review_row(
                        'Mailing lists'|trans,
                        data.lists|join(', ')|default('Announcements only'|trans),
                        'lists',
                        form,
                    ) }}
                </dl>
            </div>
        </div>

        <div class="panel">
            <div class="panel-heading"><h3>{{ 'Agreement'|trans }}</h3></div>
            <div class="panel-body">
                <p>
                    {{ 'Before submitting the registration form, please review the'|trans }}
                    <a target="_blank" href="{{ 'https://gewis.nl/association/regulations'|trans }}">
                        {{ 'Articles of Association, Internal Regulations, and Privacy Statement of GEWIS'|trans }}</a>.
                    {{ 'Payment of the one-time membership fee is handled by Stripe, please review the'|trans }}
                    <a target="_blank" href="https://stripe.com/privacy">{{ 'Privacy Policy of Stripe'|trans }}</a>.
                </p>
                {{ form_row(form.review.agreed) }}
                {{ form_row(form.review.agreedStripe) }}
            </div>
        </div>
    {% endif %}

    {{ flow.navigation(form) }}

    {{ form_end(form) }}
{% endblock %}
