{# Twig escapes a `.csv.twig` template as HTML, which would turn every `&` and quote in the data into an
   entity, so escaping is off here and the CSV's own quoting takes over: every field is wrapped in `"` and any
   `"` inside it doubled, which is what makes a separator, a quote or a newline in a value harmless.

   The macro repeats the tag because macros compile at the root of the template, outside the block below, so
   the escaping strategy of the surrounding block does not apply to them.

   The leading `sep=;` line is the hint spreadsheet software needs to read `;` as the separator. #}
{% macro row(values) %}
    {%- autoescape false -%}
        {%- for value in values -%}
            {{ loop.first ? '' : ';' }}"{{ (value ?? '')|replace({'"': '""'}) }}"
        {%- endfor -%}
    {%- endautoescape -%}
{% endmacro %}
{% import _self as csv %}
{% autoescape false %}
sep=;
{% if result is not empty %}
{{ csv.row(result|first|keys) }}
{% for line in result %}
{{ csv.row(line) }}
{% endfor %}
{% endif %}
{% endautoescape %}
