{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ label.name|localise_text|page_title }}{{ 'Labels'|trans|page_title }}{{ 'Activities'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/activities/index') }}">{{ 'Activities'|trans }}</a>
    </li>
    <li class="breadcrumb-item">
        <a href="{{ path('admin/activities/labels/index') }}">{{ 'Labels'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Edit'|trans }}</li>
{% endblock %}

{% block contents %}
    {% include 'partials/application/label-form.html.twig' with {
        'form': form,
        'cancelRoute': 'admin/activities/labels/index',
    } only %}
{% endblock %}
