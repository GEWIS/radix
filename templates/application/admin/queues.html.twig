{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ 'Queues'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item active" aria-current="page">
        {{ 'Queues'|trans }}
    </li>
{% endblock %}

{% block contents %}
    <div class="panel">
        <div class="panel-heading">
            <h3 class="mb-0">{{ 'Transports'|trans }}</h3>
        </div>
        <div class="panel-body">
            <p class="text-muted">
                {{ 'What each transport is holding right now. A count that keeps climbing means the consumers of that transport are not keeping up.'|trans }}
            </p>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'Transport'|trans }}</th>
                            <th class="text-end">{{ 'Waiting'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for transport in transports %}
                            <tr>
                                <td>
                                    <code>{{ transport.name }}</code>
                                    {% if transport.isFailureTransport %}
                                        <span class="badge text-bg-secondary">{{ 'Failures'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    {% if transport.waiting is null %}
                                        <small class="text-muted">{{ 'Unknown'|trans }}</small>
                                    {% elseif transport.waiting == 0 %}
                                        <small class="text-muted">0</small>
                                    {% else %}
                                        <span class="badge {{ transport.isFailureTransport ? 'text-bg-danger' : 'text-bg-info' }}">
                                            {{ transport.waiting }}
                                        </span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <twig:Application:Admin:FailedMessageOverview />
{% endblock %}
