{% extends 'layout.html.twig' %}

{% set slogan = company.slogan|localise_text %}

{% block page_title %}{{ company.name|page_title }}{{ parent() }}{% endblock %}
{% block meta_description %}{{ slogan is not empty ? slogan : company.description|localise_text|markdown_excerpt(200) }}{% endblock %}
{% block meta_image %}{{ company.squareLogo is not null ? absolute_url(image_url(company.squareLogo, 'w640')) : parent() }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item active" aria-current="page">
        <a href="{{ path('career/companies') }}">{{ 'Companies'|trans }}</a>
    </li>
    <li class="breadcrumb-item active">{{ company.name }}</li>
{% endblock %}

{% block contents %}
    {% set website = company.website|localise_text %}
    <div class="row g-4">
        <div class="col-lg-4 col-xl-3">
            <div class="card company-card mb-4">
                {% include 'partials/career/logo.html.twig' with {
                    'logo': company.bannerLogo,
                    'name': company.name,
                    'class': 'career-logo-plate',
                    'alt': company.name,
                } only %}
                {% if
                    company.contactName is not null
                    or company.contactAddress is not null
                    or company.contactPhone is not null
                    or company.contactEmail is not null
                    or website is not empty
                    or company.getSocialLinks|length > 0
                %}
                    <div class="card-body">
                        <h6 class="text-uppercase text-body-secondary">{{ 'Contact'|trans }}</h6>
                        {% if company.contactName is not null %}
                            <p class="mb-1"><strong>{{ company.contactName }}</strong></p>
                        {% endif %}
                        {% if company.contactAddress is not null %}
                            <p class="mb-1 text-body-secondary small">{{ company.contactAddress|nl2br }}</p>
                        {% endif %}
                        {% if company.contactPhone is not null %}
                            <p class="mb-1">
                                <a href="tel:{{ company.contactPhone }}">{{ company.contactPhone }}</a>
                            </p>
                        {% endif %}
                        {% if company.contactEmail is not null %}
                            <p class="mb-1">
                                <a href="mailto:{{ company.contactEmail }}">{{ company.contactEmail }}</a>
                            </p>
                        {% endif %}
                        {% if website is not empty %}
                            <p class="mb-1">
                                <a href="{{ website }}" target="_blank" rel="noopener noreferrer">
                                    {{ 'Visit website'|trans }}
                                </a>
                            </p>
                        {% endif %}
                        {% include 'partials/application/social-links.html.twig' with {
                            'links': company.getSocialLinks,
                        } only %}
                    </div>
                {% endif %}
            </div>

            {% if company.getNumberOfActiveJobs() > 0 %}
                <div class="panel mb-4">
                    <div class="panel-heading">
                        <h3>{{ 'Open positions'|trans }}</h3>
                    </div>
                    <div class="panel-body">
                        {% for category in vacancy_categories() %}
                            {% set vacancies = company.getActiveVacancies(category) %}
                            {% if vacancies is not empty %}
                                {% set vacancy = vacancies|first %}
                                <a class="link-row" href="{{ path('career/vacancy', {
                                    companySlug: company.slugName,
                                    category: vacancy.category.value,
                                    vacancySlug: vacancy.slugName,
                                }) }}">
                                    <span class="d-block fw-semibold">{{ vacancy.name|localise_text }}</span>
                                    <span class="d-block small text-body-secondary">{{ category.pluralLabel|trans }}</span>
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if activities is not empty %}
                <div class="panel mb-4">
                    <div class="panel-heading">
                        <h3>{{ 'Activities'|trans }}</h3>
                    </div>
                    <div class="list-group list-group-flush">
                        {% for activity in activities %}
                            <div class="list-group-item">
                                <h6 class="mb-1">
                                    <a href="{{ path('activity/view', {activity: activity.id}) }}">
                                        {{ activity.name|localise_text }}
                                    </a>
                                </h6>
                                <p class="text-muted small mb-0">
                                    {{ activity.beginTime|format_datetime(
                                        pattern: 'EEE d MMM yyyy, HH:mm',
                                        locale: app.request.locale,
                                    ) }}
                                </p>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="col-lg-8 col-xl-9">
            <h3 class="mb-1">{{ company.name }}</h3>
            {% set slogan = company.slogan|localise_text %}
            {% if slogan is not empty %}
                <p class="text-body-secondary fs-5">{{ slogan }}</p>
            {% endif %}

            {# The article the career page links to with a "Read more", so it has to be on this page. #}
            {% set featuredPackage = company.getFeaturedPackage %}
            {% if featuredPackage is not null %}
                <div class="panel">
                    <div class="panel-heading">
                        <h3><span class="fas fa-star" aria-hidden="true"></span> {{ 'Featured this month'|trans }}</h3>
                    </div>
                    <div class="panel-body markdown">
                        {{ featuredPackage.article|localise_text|markdown }}
                    </div>
                </div>
            {% endif %}

            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'Description'|trans }}</h3>
                </div>
                <div class="panel-body markdown">
                    {{ company.description|localise_text|markdown }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
