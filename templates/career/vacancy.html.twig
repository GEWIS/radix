{% extends 'layout.html.twig' %}

{% set company = vacancy.company %}

{% block page_title %}{{ vacancy.name|localise_text|page_title }}{{ parent() }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item active" aria-current="page">
        <a href="{{ path('career/companies') }}">{{ 'Companies'|trans }}</a>
    </li>
    <li class="breadcrumb-item">
        <a href="{{ path('career/company', {slug: company.slugName}) }}">{{ company.name }}</a>
    </li>
    <li class="breadcrumb-item active">{{ vacancy.name|localise_text }}</li>
{% endblock %}

{% block contents %}
    {% set vacancyWebsite = vacancy.website|localise_text %}
    {% set vacancyAttachment = vacancy.attachment|localise_text %}
    {% set companySlogan = company.slogan|localise_text %}
    <div class="row g-4">
        <div class="col-lg-4 col-xl-3">
            <div class="card company-card mb-4">
                {% include 'partials/career/logo.html.twig' with {
                    'logo': company.bannerLogo,
                    'name': company.name,
                    'class': 'career-logo-plate',
                    'alt': company.name,
                } only %}
                <div class="card-body">
                    <p class="mb-1">
                        <a href="{{ path('career/company', {slug: company.slugName}) }}">{{ company.name }}</a>
                    </p>
                    {% set location = vacancy.location|localise_text %}
                    {% if location is not empty %}
                        <p class="text-body-secondary small mb-2">{{ location }}</p>
                    {% endif %}
                    <div class="d-flex flex-wrap gap-1 mb-3">
                        <span class="badge {{ vacancy.category.badgeClass }}">
                            {{ vacancy.category.label|trans }}
                        </span>
                        {% for label in vacancy.getLabels %}
                            <span class="badge badge-tag">{{ label.name|localise_text }}</span>
                        {% endfor %}
                    </div>
                    {% if vacancy.endDate is not null %}
                        <p class="text-body-secondary small mb-3">
                            {{ 'Open until %date%'|trans({'%date%': vacancy.endDate|date('j F Y')}) }}
                        </p>
                    {% endif %}
                    {% if vacancyWebsite is not empty %}
                        <a href="{{ vacancyWebsite }}" target="_blank" rel="noopener noreferrer"
                           class="btn btn-gewis-primary w-100">
                            {{ 'Visit website'|trans }}
                        </a>
                    {% endif %}
                    {% if vacancyAttachment is not empty %}
                        <a href="{{ vacancyAttachment }}" target="_blank" rel="noopener noreferrer"
                           class="btn btn-outline-secondary w-100 {{ vacancyWebsite is not empty ? 'mt-2' : '' }}">
                            {{ 'View attachment'|trans }}
                        </a>
                    {% endif %}
                </div>
            </div>

            {% if companySlogan is not empty %}
                <div class="panel mb-4">
                    <div class="panel-heading">
                        <h3>{{ 'About %company%'|trans({'%company%': company.name}) }}</h3>
                    </div>
                    <div class="panel-body">
                        <p class="text-body-secondary">{{ companySlogan }}</p>
                        <a href="{{ path('career/company', {slug: company.slugName}) }}">
                            {{ 'View company page'|trans }}
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="col-lg-8 col-xl-9">
            <h3 class="mb-1">{{ vacancy.name|localise_text }}</h3>
            <p class="text-body-secondary fs-5">
                {{ 'at %company%'|trans({'%company%': company.name}) }}
            </p>

            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'Description'|trans }}</h3>
                </div>
                <div class="panel-body markdown">
                    {{ vacancy.description|localise_text|markdown }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
