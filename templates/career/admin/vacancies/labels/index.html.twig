{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ 'Labels'|trans|page_title }}{{ 'Career'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/career/index') }}">{{ 'Career'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Labels'|trans }}</li>
{% endblock %}

{% block contents %}
    {% include 'partials/application/label-overview.html.twig' with {
        'heading': 'Vacancy labels'|trans,
        'intro': 'Labels are shared by every company, so renaming one changes it everywhere it is used.'|trans,
        'labels': labels,
        'form': form,
        'editRoute': 'admin/career/vacancies/labels/edit',
        'retireRoute': 'admin/career/vacancies/labels/retire',
        'restoreRoute': 'admin/career/vacancies/labels/restore',
        'deleteRoute': 'admin/career/vacancies/labels/delete',
        'retireToken': 'vacancy_label_retire-',
        'restoreToken': 'vacancy_label_restore-',
        'deleteToken': 'vacancy_label_delete-',
    } only %}
{% endblock %}
