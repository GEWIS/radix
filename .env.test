# The test environment's own file. Symfony does not read `.env.local` under `test`, and `.env` holds almost nothing, so
# everything the test kernel needs is here. CI loads this same file into the job environment (see the workflows).
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Fake-but-parseable values so the test kernel can compile without the external services (locally compose.yaml's
# x-app-environment injects the real ones, which override these). Connections are lazy, so the Valkey and Mercure
# hosts are never contacted. Both databases point at the engines production runs: integration tests need them because
# custom DQL functions, named locks and engine-specific column types cannot be reproduced on SQLite. CI runs a
# PostgreSQL and a MariaDB service on 127.0.0.1; the `when@test` doctrine config isolates tests onto separate `_test`
# databases.
DATABASE_DSN='postgresql://gewisdb:gewisdb@127.0.0.1:5432/gewisdb?serverVersion=16&charset=utf8'
WEB_DATABASE_DSN='pdo-mysql://gewis:gewis@127.0.0.1:3306/gewis?serverVersion=11.8.8-mariadb&charset=utf8mb4&collation=utf8mb4_uca1400_ai_ci'
VALKEY_DSN='valkey://127.0.0.1:6379'
LOCK_DSN='valkey://127.0.0.1:6379'
MERCURE_URL='http://mercure/.well-known/mercure'
MERCURE_PUBLIC_URL='http://localhost/.well-known/mercure'
MERCURE_JWT_SECRET='thisisnotsecretbutitmustbeatleast256bitstosignwithhs256'
VAR_DUMPER_SERVER='127.0.0.1:9912'

# Addresses and hosts. Nothing is delivered or fetched under test; these exist because the services that hold them are
# constructed, and because a rendered page names some of them.
DEFAULT_URI='http://localhost'
SERVER_HOSTNAME='database.gewis.nl'
MATOMO_DOMAIN='http://localhost:82'
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
MAILER_DSN='null://null'
MAIL_FROM_ADDRESS='noreply@example.com'
MAIL_REPLY_TO_SECRETARY_ADDRESS='secretary@example.com'
MAIL_TO_CHECKER_RESULT_ADDRESS='checker@example.com'
MAIL_TO_REPORT_ERROR_ADDRESS='errors@example.com'
MAIL_TO_SUBSCRIPTION_ADDRESS='subscriptions@example.com'
MAIL_TO_INTERNAL_AFFAIRS_ADDRESS='internal@example.com'
MAIL_TO_EXTERNAL_AFFAIRS_ADDRESS='external@example.com'
MAIL_TO_C4_ADDRESS='c4@example.com'
MAIL_TO_GEFLITST_ADDRESS='geflitst@example.com'
MAIL_TO_GEFLITST_PLANKA_ADDRESS='planka@example.com'
MAIL_TO_GEFLITST_PLANKA_KEY='board-1234'
MAIL_TO_TREASURER_ADDRESS='treasurer@example.com'

# The mailing-list services are constructed but never reach the network: every test that exercises them replaces the
# HTTP client.
# Never reached under test, but the schedule test constructs every scheduled command and this one reads them.
SSH_REMOTE='sftp.example.com'
SSH_USERNAME='radix'
SSH_PASSWORD='not-a-password'

MAILMAN_API_ENDPOINT='http://mailman-core:8001/3.1/'
MAILMAN_API_USERNAME='restadmin'
MAILMAN_API_PASSWORD='restpass'
LISTMONK_API_ENDPOINT='http://listmonk:9000/api/'
LISTMONK_API_USERNAME='listmonkapi'
LISTMONK_API_PASSWORD='listmonkpwd'

# Where Stripe would send someone back to. No checkout is ever opened under test.
STRIPE_CANCEL_URL='http://localhost/member/subscribe/checkout/cancelled?stripe_session_id={CHECKOUT_SESSION_ID}'
STRIPE_SUCCESS_URL='http://localhost/member/subscribe/checkout/completed?stripe_session_id={CHECKOUT_SESSION_ID}'

# Prefilled on the sign-in form. A member number, which is what the sign-in asks for.
DEMO_CREDENTIALS_USERNAME='8000'
DEMO_CREDENTIALS_PASSWORD='gewiswebgewis'

# External-application JWT signing key set for the test env: a throwaway JWKSet with one key per signing algorithm,
# each naming its own in `alg` (Ed25519 for EdDSA, P-521 for ES512, an RSA key each for PS512 and RS512).
# `.env.local` is not loaded under `test`, so the key set has to live here for the external-application flow to sign
# anything.
